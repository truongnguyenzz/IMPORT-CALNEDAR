
/***************************************************************
 * SMART CALENDAR SYNC V3.2 — INDEPENDENT CLEANUP
 * SHEET: TUẦN
 * READY DATE: M16:M22
 * READY TASK: O,Q,S,U,W,Y,AA,AC,AE,AG,AI,AK
 * MASTER: A:G, bắt đầu từ hàng 3
 * CLEANUP: Xóa tất cả sự kiện có SCV2_ID thuộc ngày được chọn.
 * CLEANUP KHÔNG phụ thuộc MASTER, READY TASK hoặc thiết lập thời gian.
 ***************************************************************/
const SCV3 = {
  SHEET: 'TUẦN',
  MASTER_ROW: 3,
  READY_FIRST_ROW: 16,
  READY_LAST_ROW: 22,
  DATE_COL: 13,
  TASK_FIRST_COL: 15,
  TASK_LAST_COL: 37,
  TASK_STEP: 2,
  SECONDARY_FIRST_ROW: 4,
  SECONDARY_LAST_ROW: 16,
  SECONDARY_TASK_COLS: [10,12,14,16],
  SECONDARY_PERIOD_COL: 8,
  SECONDARY_COLOR: CalendarApp.EventColor.ORANGE,
  START_HOUR: 7.5,
  DEFAULT_GAP_MINUTES: 15,
  DEFAULT_SLEEP_START: '02:00',
  DEFAULT_SLEEP_DURATION: 5.5,
  SLEEP_TITLE: '💤 Ngủ đêm',
  MARKER: '[[SCV2_ID:',
  TIMEZONE: Session.getScriptTimeZone()
};
const SCV3_DAYS = ['THỨ HAI','THỨ BA','THỨ TƯ','THỨ NĂM','THỨ SÁU','THỨ BẢY','CHỦ NHẬT'];
function showCalendarSyncDialogV2() {
  showCalendarSyncDialogV3();
}
function showCalendarSyncDialogV3() {
  const html = HtmlService.createHtmlOutput(SCV3_getHTML_()).setWidth(680).setHeight(850);
  SpreadsheetApp.getUi().showModalDialog(html,'SMART CALENDAR SYNC V3.2');
}
function SCV3_getDays() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SCV3.SHEET);
  if (!sheet) throw new Error('Không tìm thấy sheet TUẦN.');
  const range = sheet.getRange(SCV3.READY_FIRST_ROW,SCV3.DATE_COL,7,1);
  const values = range.getValues();
  const displays = range.getDisplayValues();
  return values.map((r,i) => {
    const date = SCV3_parseDate_(r[0],displays[i][0]);
    return {
      index:i,
      valid:!!date,
      label:SCV3_DAYS[i],
      date:date ? Utilities.formatDate(date,SCV3.TIMEZONE,'dd/MM/yyyy') : 'Chưa có ngày',
      row:SCV3.READY_FIRST_ROW+i
    };
  });
}
function SCV3_sync(options) {
  options = options || {};
  const selectedDays = [...new Set((options.selectedDays || []).map(Number))].sort((a,b) => a-b);
  const clearOld = options.clearOld === true;
  const createSync = options.createSync === true;
  if (!selectedDays.length) throw new Error('Bạn chưa chọn ngày đồng bộ.');
  if (!clearOld && !createSync) throw new Error('Bạn chưa chọn chức năng đồng bộ.');
  selectedDays.forEach(index => {
    if (!Number.isInteger(index) || index < 0 || index > 6) throw new Error('Ngày được chọn không hợp lệ.');
  });
  const gapMinutes = Number(options.gapMinutes);
  const sleepStart = String(options.sleepStart || SCV3.DEFAULT_SLEEP_START);
  const sleepDuration = Number(options.sleepDuration);
  if (createSync) {
    if (!Number.isFinite(gapMinutes) || gapMinutes < 0 || gapMinutes > 1440) throw new Error('Khoảng nghỉ không hợp lệ.');
    if (!Number.isFinite(sleepDuration) || sleepDuration <= 0 || sleepDuration > 24) throw new Error('Thời lượng ngủ không hợp lệ.');
    if (!/^([01]\d|2[0-3]):[0-5]\d$/.test(sleepStart)) throw new Error('Giờ bắt đầu ngủ không hợp lệ.');
  }
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(10000)) throw new Error('Đang có một tiến trình đồng bộ khác. Vui lòng thử lại.');
  try {
    const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SCV3.SHEET);
    if (!sheet) throw new Error('Không tìm thấy sheet TUẦN.');
    const dateRange = sheet.getRange(SCV3.READY_FIRST_ROW,SCV3.DATE_COL,7,1);
    const dateValues = dateRange.getValues();
    const dateDisplays = dateRange.getDisplayValues();
    const selectedDateKeys = new Set();
    const selectedDateObjects = [];
    const selectedDateInfo = [];
    selectedDays.forEach(dayIndex => {
      const date = SCV3_parseDate_(dateValues[dayIndex][0],dateDisplays[dayIndex][0]);
      if (!date) throw new Error('Ngày tại M'+(SCV3.READY_FIRST_ROW+dayIndex)+' không hợp lệ.');
      const dateKey = SCV3_dateKey_(date);
      selectedDateKeys.add(dateKey);
      selectedDateObjects.push(date);
      selectedDateInfo.push({dayIndex:dayIndex,date:date,dateKey:dateKey});
    });
    const rangeStart = new Date(Math.min(...selectedDateObjects.map(d => d.getTime())));
    rangeStart.setHours(0,0,0,0);
    const rangeEnd = new Date(Math.max(...selectedDateObjects.map(d => d.getTime())));
    rangeEnd.setHours(0,0,0,0);
    rangeEnd.setDate(rangeEnd.getDate()+2);
    const calendar = CalendarApp.getDefaultCalendar();
    const existingEvents = calendar.getEvents(rangeStart,rangeEnd);
    const operations = [];
    const stats = {created:0,updated:0,unchanged:0,deleted:0,skipped:0,total:0};
    const actions = [];
    if (clearOld) {
      // Lấy REST event ID chuẩn để gửi nhiều lệnh xóa trong một HTTP batch.
      SCV3_listManagedDeleteOperations_(rangeStart,rangeEnd,selectedDateKeys)
        .forEach(op => operations.push(op));
    }
    if (createSync) {
      const readyValues = sheet.getRange(SCV3.READY_FIRST_ROW,SCV3.TASK_FIRST_COL,7,SCV3.TASK_LAST_COL-SCV3.TASK_FIRST_COL+1).getDisplayValues();

      // Lập task chính trước để xác định thời điểm kết thúc cuối cùng trong từng ngày.
      const master = SCV3_buildMasterIndex_(sheet);
      const primaryPlans = selectedDateInfo.map(day => ({
        dayIndex:day.dayIndex,
        date:day.date,
        dateKey:day.dateKey,
        plan:SCV3_buildDayPlan_(master,readyValues[day.dayIndex],day.date,gapMinutes,sleepStart,sleepDuration)
      }));

      // Task phụ được gom theo CLASS và xếp nối tiếp sau task chính cuối cùng.
      const primaryByDate = new Map(primaryPlans.map(day => [day.dateKey,day.plan]));
      const secondaryPlans = selectedDateInfo.map(day => {
        const daySheetName = SCV3_DAYS[day.dayIndex];
        const daySheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(daySheetName);
        if (!daySheet) throw new Error('Không tìm thấy sheet '+daySheetName+'.');
        const secondaryMaster = SCV3_buildSecondaryIndex_(daySheet);
        return {
          dayIndex:day.dayIndex,
          date:day.date,
          dateKey:day.dateKey,
          plan:SCV3_buildSecondaryDayPlan_(daySheet,secondaryMaster,day.date,primaryByDate.get(day.dateKey) || [])
        };
      });

      const eventById = new Map();
      existingEvents.forEach(event => {
        const id = SCV3_getManagedId_(event);
        if (id && !eventById.has(id)) eventById.set(id,event);
      });

      // Thứ tự operations: DELETE (nếu bật) -> toàn bộ task phụ -> task chính.
      const orderedPlans = secondaryPlans.concat(primaryPlans);
      orderedPlans.forEach(day => {
        day.plan.forEach(item => {
          stats.total++;
          const event = eventById.get(item.id) || SCV3_findLegacyEvent_(existingEvents,item) || null;
          operations.push({
            kind:'SYNC',
            phase:item.type === 'SECONDARY_TASK' ? 'SECONDARY' : 'PRIMARY',
            item:item,
            dayIndex:day.dayIndex,
            dateKey:day.dateKey,
            existingEventId:event ? event.getId() : null
          });
        });
      });
    }
    const token = Utilities.getUuid().replace(/-/g,'');
    const state = {
      token:token,
      cursor:0,
      operations:operations,
      stats:stats,
      actions:actions,
      days:selectedDays.length,
      settings:{
        gapMinutes:createSync ? gapMinutes : null,
        sleepStart:createSync ? sleepStart : null,
        sleepDuration:createSync ? sleepDuration : null,
        clearOld:clearOld,
        createSync:createSync
      },
      rangeStart:rangeStart.getTime(),
      rangeEnd:rangeEnd.getTime(),
      createdAt:Date.now()
    };
    SCV3_saveJob_(state);
    return SCV3_processBatch_(token);
  } finally {
    lock.releaseLock();
  }
}
function SCV3_continueSync(token) {
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(10000)) throw new Error('Đang có một tiến trình đồng bộ khác. Vui lòng thử lại sau.');
  try {
    return SCV3_processBatch_(String(token || ''));
  } finally {
    lock.releaseLock();
  }
}
function SCV3_processBatch_(token) {
  const state = SCV3_loadJob_(token);
  if (!state) throw new Error('Không tìm thấy tiến trình đồng bộ hoặc tiến trình đã hết hạn. Hãy bắt đầu lại.');
  const firstOperation = state.operations[state.cursor];
  if (firstOperation && firstOperation.kind === 'DELETE') {
    return SCV3_processDeleteBatch_(state,token);
  }
  if (firstOperation && firstOperation.kind === 'SYNC') {
    return SCV3_processSyncBatch_(state,token);
  }
  return SCV3_finishJob_(state,token);
}
/**
 * CalendarApp.getId() là iCalUID; REST batch DELETE cần event.id.
 * Vì vậy đọc danh sách qua Calendar API để lấy đúng REST ID.
 */
function SCV3_listCalendarRestEvents_(rangeStart,rangeEnd) {
  const baseUrl = 'https://www.googleapis.com/calendar/v3/calendars/primary/events';
  const params = [
    'timeMin='+encodeURIComponent(rangeStart.toISOString()),
    'timeMax='+encodeURIComponent(rangeEnd.toISOString()),
    'maxResults=2500',
    'singleEvents=true'
  ];
  const events = [];
  let pageToken = '';
  do {
    const url = baseUrl+'?'+params.join('&')+(pageToken ? '&pageToken='+encodeURIComponent(pageToken) : '');
    const response = UrlFetchApp.fetch(url,{
      method:'get',
      headers:{Authorization:'Bearer '+ScriptApp.getOAuthToken()},
      muteHttpExceptions:true
    });
    const status = response.getResponseCode();
    if (status < 200 || status >= 300) {
      throw new Error('Không thể đọc danh sách Google Calendar (HTTP '+status+'): '+response.getContentText().slice(0,500));
    }
    const data = JSON.parse(response.getContentText() || '{}');
    (data.items || []).forEach(event => events.push(event));
    pageToken = data.nextPageToken || '';
  } while (pageToken);
  return events;
}


/**
 * Đọc phản hồi multipart theo Content-ID, không dựa vào thứ tự ngẫu nhiên
 * hoặc chỉ đếm các dòng HTTP trong toàn bộ response.
 */
function SCV3_parseBatchResponse_(responseText,boundary,idPrefix,expectedCount) {
  const source = String(responseText || '');
  const results = new Map();
  const idPattern = new RegExp('Content-ID\\s*:\\s*<(?:(?:response)-)?'+idPrefix+'-(\\d+)>','ig');
  const matches = [];
  let match;
  while ((match = idPattern.exec(source)) !== null) matches.push({index:Number(match[1]),start:match.index,end:idPattern.lastIndex});
  matches.forEach((part,index) => {
    const nextStart = index+1<matches.length ? matches[index+1].start : source.length;
    const responsePart = source.slice(part.start,nextStart);
    const statusMatch = responsePart.match(/HTTP\/1\.[01]\s+(\d{3})/i);
    if (!statusMatch) return;
    results.set(part.index,{
      status:Number(statusMatch[1]),
      response:responsePart.trim().slice(-1200)
    });
  });
  if (results.size !== expectedCount) {
    throw new Error('Không đối chiếu được đủ Content-ID từ Google Calendar ('+results.size+'/'+expectedCount+'). Phản hồi: '+source.slice(0,1200));
  }
  for (let i=0;i<expectedCount;i++) {
    if (!results.has(i)) throw new Error('Thiếu phản hồi Content-ID '+idPrefix+'-'+i+'.');
  }
  return results;
}

function SCV3_verifyWrittenEvents_(entries,rangeStart,rangeEnd) {
  const events = SCV3_listCalendarRestEvents_(rangeStart,rangeEnd);
  const byId = new Map();
  events.forEach(event => {
    if (event.id && !byId.has(event.id)) byId.set(event.id,event);
  });
  const failures = [];
  entries.forEach(entry => {
    const item = entry.op.item;
    const expectedId = entry.event ? entry.event.id : item.id;
    const event = byId.get(expectedId);
    if (!event) {
      failures.push(item.title+': không tìm thấy event.id='+expectedId);
      return;
    }
    const marker = String(event.description || '').match(/\[\[SCV2_ID:([^\]]+)\]\]/);
    const actualStart = event.start && event.start.dateTime ? new Date(event.start.dateTime).getTime() : NaN;
    const actualEnd = event.end && event.end.dateTime ? new Date(event.end.dateTime).getTime() : NaN;
    const valid = marker && marker[1] === item.id &&
      String(event.summary || '') === item.title &&
      String(event.description || '') === item.description &&
      actualStart === item.start &&
      actualEnd === item.end &&
      (!entry.body.colorId || String(event.colorId || '') === entry.body.colorId);
    if (!valid) failures.push(item.title+': event tồn tại nhưng dữ liệu không khớp (id='+expectedId+').');
  });
  return {success:failures.length===0,failures:failures};
}

function SCV3_listManagedDeleteOperations_(rangeStart,rangeEnd,selectedDateKeys) {
  return SCV3_listCalendarRestEvents_(rangeStart,rangeEnd).filter(event => {
    const managed = String(event.description || '').match(/\[\[SCV2_ID:([^\]]+)\]\]/);
    if (!managed || !event.id) return false;
    const startValue = event.start && (event.start.dateTime || event.start.date);
    if (!startValue) return false;
    let eventDate;
    if (event.start.date) {
      const parts = event.start.date.split('-').map(Number);
      eventDate = new Date(parts[0],parts[1]-1,parts[2]);
    } else {
      eventDate = new Date(startValue);
    }
    if (isNaN(eventDate.getTime())) return false;
    const dateKey = SCV3_dateKey_(eventDate);
    if (!selectedDateKeys.has(dateKey)) return false;
    event._scv3DateKey = dateKey;
    return true;
  }).map(event => ({
    kind:'DELETE',
    eventId:event.id,
    title:String(event.summary || ''),
    day:event._scv3DateKey
  }));
}

/** Xóa tối đa 20 task bằng một HTTP multipart batch request. */
function SCV3_processDeleteBatch_(state,token) {
  const batch = state.operations.slice(state.cursor,state.cursor+20);
  if (!batch.length) return null;
  const boundary = 'scv3_batch_'+Utilities.getUuid().replace(/-/g,'');
  const lines = [];
  batch.forEach((op,index) => {
    lines.push('--'+boundary,'Content-Type: application/http','Content-ID: <delete-'+index+'>','',
      'DELETE /calendar/v3/calendars/primary/events/'+encodeURIComponent(op.eventId)+' HTTP/1.1','');
  });
  lines.push('--'+boundary+'--');
  try {
    const response = UrlFetchApp.fetch('https://www.googleapis.com/batch/calendar/v3',{
      method:'post',
      contentType:'multipart/mixed; boundary='+boundary,
      payload:lines.join('\r\n'),
      headers:{Authorization:'Bearer '+ScriptApp.getOAuthToken()},
      muteHttpExceptions:true
    });
    const httpStatus = response.getResponseCode();
    const responseText = response.getContentText();
    if (httpStatus < 200 || httpStatus >= 300) {
      throw new Error('Batch delete thất bại (HTTP '+httpStatus+'): '+responseText.slice(0,700));
    }
    const statuses = [];
    const regex = /HTTP\/1\.[01]\s+(\d{3})[^\r\n]*/g;
    let match;
    while ((match = regex.exec(responseText)) !== null) statuses.push(Number(match[1]));
    if (statuses.length !== batch.length) {
      throw new Error('Không đọc đủ kết quả batch delete ('+statuses.length+'/'+batch.length+'). '+responseText.slice(0,700));
    }
    let completed = 0;
    for (let i=0;i<batch.length;i++) {
      const status = statuses[i], op = batch[i];
      if ((status >= 200 && status < 300) || status === 404 || status === 410) {
        if (status >= 200 && status < 300) {
          state.stats.deleted++;
          state.actions.push({day:op.day,action:'DELETED',title:op.title});
        } else state.stats.skipped++;
        completed++;
      } else break;
    }
    state.cursor += completed;
    SCV3_saveJob_(state);
    if (completed < batch.length) {
      return {success:false,done:false,paused:true,retryable:false,token:token,progress:state.cursor,total:state.operations.length,
        error:'Google Calendar từ chối một lệnh trong batch (HTTP '+statuses[completed]+').',stats:state.stats};
    }
    if (state.cursor >= state.operations.length) return SCV3_finishJob_(state,token);
    return {success:true,done:false,paused:false,token:token,progress:state.cursor,total:state.operations.length,stats:state.stats};
  } catch (error) {
    SCV3_saveJob_(state);
    return {success:false,done:false,paused:true,token:token,progress:state.cursor,total:state.operations.length,
      error:String(error && error.message ? error.message : error),stats:state.stats};
  }
}

/**
 * Batch INSERT/PATCH: tối đa 20 task trong một HTTP request.
 * ID do client cung cấp giúp INSERT an toàn khi phải retry sau timeout.
 */
function SCV3_processSyncBatch_(state,token) {
  // Không để một HTTP batch chứa đồng thời task phụ và task chính.
  // Nhờ vậy toàn bộ batch task phụ hoàn tất trước khi bắt đầu batch task chính.
  const batch = [];
  const phase = state.operations[state.cursor] ? state.operations[state.cursor].phase : null;
  for (let i=state.cursor;i<state.operations.length && batch.length<20;i++) {
    const operation = state.operations[i];
    if (operation.kind !== 'SYNC' || operation.phase !== phase) break;
    batch.push(operation);
  }
  if (!batch.length) return null;
  const firstStart = Math.min.apply(null,batch.map(op => op.item.start));
  const lastEnd = Math.max.apply(null,batch.map(op => op.item.end));
  const rangeStart = new Date(firstStart);
  rangeStart.setHours(0,0,0,0);
  const rangeEnd = new Date(lastEnd);
  rangeEnd.setHours(0,0,0,0);
  rangeEnd.setDate(rangeEnd.getDate()+2);

  const restEvents = SCV3_listCalendarRestEvents_(rangeStart,rangeEnd);
  const byManagedId = new Map();
  const byICalUid = new Map();
  restEvents.forEach(event => {
    const marker = String(event.description || '').match(/\[\[SCV2_ID:([^\]]+)\]\]/);
    if (marker && !byManagedId.has(marker[1])) byManagedId.set(marker[1],event);
    if (event.iCalUID && !byICalUid.has(event.iCalUID)) byICalUid.set(event.iCalUID,event);
  });

  const prepared = batch.map(op => {
    const item = op.item;
    const event = byManagedId.get(item.id) || (op.existingEventId ? byICalUid.get(op.existingEventId) : null);
    const start = new Date(item.start).toISOString();
    const end = new Date(item.end).toISOString();
    const body = {
      summary:item.title,
      description:item.description,
      start:{dateTime:start},
      end:{dateTime:end}
    };
    if (item.color) body.colorId = String(item.color);
    const same = event &&
      String(event.summary || '') === item.title &&
      String(event.description || '') === item.description &&
      new Date(event.start && event.start.dateTime || 0).getTime() === item.start &&
      new Date(event.end && event.end.dateTime || 0).getTime() === item.end &&
      (!body.colorId || String(event.colorId || '') === body.colorId);
    return {op:op,event:event,body:body,same:!!same};
  });

  const writes = prepared.filter(entry => !entry.same);
  if (!writes.length) {
    prepared.forEach(entry => {
      state.stats.unchanged++;
      state.actions.push({day:SCV3_DAYS[entry.op.dayIndex],action:'UNCHANGED',title:entry.op.item.title});
    });
    state.cursor += batch.length;
    SCV3_saveJob_(state);
    if (state.cursor >= state.operations.length) return SCV3_finishJob_(state,token);
    return {success:true,done:false,paused:false,token:token,progress:state.cursor,total:state.operations.length,stats:state.stats};
  }

  const boundary = 'scv3_sync_'+Utilities.getUuid().replace(/-/g,'');
  const lines = [];
  writes.forEach((entry,index) => {
    const item = entry.op.item;
    const isUpdate = !!entry.event;
    const method = isUpdate ? 'PATCH' : 'POST';
    const path = isUpdate
      ? '/calendar/v3/calendars/primary/events/'+encodeURIComponent(entry.event.id)
      : '/calendar/v3/calendars/primary/events';
    const body = Object.assign({},entry.body);
    if (!isUpdate) body.id = item.id;
    lines.push('--'+boundary,'Content-Type: application/http','Content-ID: <sync-'+index+'>','',
      method+' '+path+' HTTP/1.1',
      'Content-Type: application/json',
      '',
      JSON.stringify(body));
  });
  lines.push('--'+boundary+'--');

  try {
    const response = UrlFetchApp.fetch('https://www.googleapis.com/batch/calendar/v3',{
      method:'post',
      contentType:'multipart/mixed; boundary='+boundary,
      payload:lines.join('\r\n'),
      headers:{Authorization:'Bearer '+ScriptApp.getOAuthToken()},
      muteHttpExceptions:true
    });
    const httpStatus = response.getResponseCode();
    const responseText = response.getContentText();
    if (httpStatus < 200 || httpStatus >= 300) {
      throw new Error('Batch tạo/cập nhật thất bại (HTTP '+httpStatus+'): '+responseText.slice(0,700));
    }
    const responseByIndex = SCV3_parseBatchResponse_(responseText,boundary,'sync',writes.length);

    // Chỉ chấp nhận 2xx hoặc 409 (ID đã tồn tại); các lệnh lỗi không được tính tiến độ.
    const rejected = writes.find((entry,index) => {
      const status = responseByIndex.get(index).status;
      return !((status >= 200 && status < 300) || status === 409);
    });
    if (rejected) {
      const rejectedIndex = writes.indexOf(rejected);
      const result = responseByIndex.get(rejectedIndex);
      SCV3_saveJob_(state);
      return {success:false,done:false,paused:true,token:token,progress:state.cursor,total:state.operations.length,
        error:'Google Calendar từ chối "'+rejected.op.item.title+'" (HTTP '+result.status+'). Chi tiết: '+result.response.slice(-700),stats:state.stats};
    }

    // Đọc lại Calendar sau mỗi batch. Không ghi nhận thành công nếu chưa thấy đủ event.
    const verification = SCV3_verifyWrittenEvents_(writes,rangeStart,rangeEnd);
    if (!verification.success) {
      // Giữ lại phản hồi từng lệnh để phân biệt lỗi INSERT với lỗi đọc/xác minh.
      const responseDiagnostics = writes.map((entry,index) => {
        const part = responseByIndex.get(index);
        return {
          title:entry.op.item.title,
          id:entry.op.item.id,
          method:entry.event ? 'PATCH' : 'POST',
          httpStatus:part.status,
          response:part.response.slice(-900)
        };
      });
      const diagnostic = {
        calendar:'primary',
        rangeStart:rangeStart.toISOString(),
        rangeEnd:rangeEnd.toISOString(),
        eventsReadBack:SCV3_listCalendarRestEvents_(rangeStart,rangeEnd).length,
        batchItems:responseDiagnostics,
        verificationFailures:verification.failures
      };
      SCV3_saveJob_(state);
      return {success:false,done:false,paused:true,retryable:false,token:token,progress:state.cursor,total:state.operations.length,
        error:'XÁC MINH SAU BATCH THẤT BẠI. Không tăng bộ đếm. Chẩn đoán: '+JSON.stringify(diagnostic),stats:state.stats};
    }

    // Chỉ cập nhật thống kê sau khi tất cả thao tác trong lô đã được xác minh.
    prepared.forEach(entry => {
      if (entry.same) {
        state.stats.unchanged++;
        state.actions.push({day:SCV3_DAYS[entry.op.dayIndex],action:'UNCHANGED',title:entry.op.item.title});
      } else if (entry.event) {
        state.stats.updated++;
        state.actions.push({day:SCV3_DAYS[entry.op.dayIndex],action:'UPDATED',title:entry.op.item.title});
      } else {
        state.stats.created++;
        state.actions.push({day:SCV3_DAYS[entry.op.dayIndex],action:'CREATED',title:entry.op.item.title});
      }
    });

    state.cursor += batch.length;
    SCV3_saveJob_(state);
    if (state.cursor >= state.operations.length) return SCV3_finishJob_(state,token);
    return {success:true,done:false,paused:false,token:token,progress:state.cursor,total:state.operations.length,stats:state.stats};
  } catch (error) {
    SCV3_saveJob_(state);
    return {success:false,done:false,paused:true,token:token,progress:state.cursor,total:state.operations.length,
      error:String(error && error.message ? error.message : error),stats:state.stats};
  }
}

function SCV3_finishJob_(state,token) {
  const result = {success:true,done:true,days:state.days,stats:state.stats,actions:state.actions,settings:state.settings};
  SCV3_deleteJob_(token);
  return result;
}

function SCV3_saveJob_(state) {
  const props = PropertiesService.getScriptProperties();
  const key = 'SCV3_JOB_'+state.token;
  const json = JSON.stringify(state);
  const chunkSize = 2000;
  const count = Math.ceil(json.length/chunkSize);
  const oldCount = Number(props.getProperty(key+'_COUNT') || 0);
  for (let i=0;i<count;i++) props.setProperty(key+'_'+i,json.slice(i*chunkSize,(i+1)*chunkSize));
  props.setProperty(key+'_COUNT',String(count));
  for (let i=count;i<oldCount;i++) props.deleteProperty(key+'_'+i);
}
function SCV3_loadJob_(token) {
  if (!token) return null;
  const props = PropertiesService.getScriptProperties();
  const key = 'SCV3_JOB_'+token;
  const count = Number(props.getProperty(key+'_COUNT') || 0);
  if (!count) return null;
  let json = '';
  for (let i=0;i<count;i++) {
    const part = props.getProperty(key+'_'+i);
    if (part === null) return null;
    json += part;
  }
  try { return JSON.parse(json); } catch (e) { return null; }
}
function SCV3_deleteJob_(token) {
  const props = PropertiesService.getScriptProperties();
  const key = 'SCV3_JOB_'+token;
  const count = Number(props.getProperty(key+'_COUNT') || 0);
  for (let i=0;i<count;i++) props.deleteProperty(key+'_'+i);
  props.deleteProperty(key+'_COUNT');
}
function SCV3_buildMasterIndex_(sheet) {
  const lastRow = sheet.getLastRow();
  if (lastRow < SCV3.MASTER_ROW) throw new Error('MASTER DATABASE đang trống.');
  const count = lastRow-SCV3.MASTER_ROW+1;
  const values = sheet.getRange(SCV3.MASTER_ROW,1,count,7).getValues();
  const formulas = sheet.getRange(SCV3.MASTER_ROW,1,count,1).getFormulas();
  const map = {};
  let currentCategory = '';
  for (let i=0;i<values.length;i++) {
    const r = values[i];
    const aValue = String(r[0] || '').trim();
    const aFormula = String(formulas[i][0] || '');
    const categoryMatch = (aFormula+' '+aValue).match(/\[\s*Phân loại\s*[:]\s*([^\]]+)\s*\]/i);
    if (categoryMatch) currentCategory = categoryMatch[1].trim();
    else if (aValue) currentCategory = aValue;
    const className = String(r[1] || '').trim();
    const taskName = String(r[2] || '').trim();
    if (!taskName) continue;
    const key = SCV3_normalize_(taskName);
    if (map[key]) continue;
    map[key] = {
      name:taskName,
      className:className,
      content:String(r[3] || '').trim(),
      pr:SCV3_number_(r[4]),
      gi:SCV3_number_(r[5]),
      duration:SCV3_number_(r[6]),
      category:className.toUpperCase() === 'SYSTEM' ? 'SYSTEM' : currentCategory
    };
  }
  return map;
}
/**
 * Đọc bảng tổng hợp task phụ A1:F25 trên từng sheet THỨ...
 * Cột B là CLASS hiển thị trên Calendar; C là tên task; D là nội dung; E là DURING (giờ).
 */
function SCV3_buildSecondaryIndex_(daySheet) {
  const values = daySheet.getRange('A1:F25').getDisplayValues();
  const map = {};
  for (let i=0;i<values.length;i++) {
    const row = values[i];
    const className = String(row[1] || '').trim();
    const taskName = String(row[2] || '').trim();
    if (!taskName) continue;
    const key = SCV3_normalize_(taskName);
    if (map[key]) continue;
    const duration = SCV3_number_(row[4]);
    map[key] = {
      name:taskName,
      className:className,
      content:String(row[3] || '').trim(),
      duration:duration
    };
  }
  return map;
}

/**
 * Lập task phụ theo đúng vùng giờ H4:Q16.
 * Duyệt từng hàng từ trên xuống, trong mỗi hàng duyệt J/L/N/P từ trái sang phải.
 * K/M/O/Q là thời lượng phút để xếp lịch; DURING trong mô tả lấy từ cột E (giờ).
 */
function SCV3_buildSecondaryDayPlan_(daySheet,master,date,primaryPlan) {
  const firstRow = SCV3.SECONDARY_FIRST_ROW;
  const rowCount = SCV3.SECONDARY_LAST_ROW-firstRow+1;
  const values = daySheet.getRange(firstRow,8,rowCount,10).getDisplayValues(); // H:Q
  const slots = [
    {taskOffset:2,durationOffset:3},
    {taskOffset:4,durationOffset:5},
    {taskOffset:6,durationOffset:7},
    {taskOffset:8,durationOffset:9}
  ];
  const groups = new Map();
  const occurrence = {};

  // Đọc task theo thứ tự trên bảng lịch, gom các task cùng CLASS (cột B).
  for (let r=0;r<values.length;r++) {
    for (const slot of slots) {
      const taskName = String(values[r][slot.taskOffset] || '').trim();
      if (!taskName) continue;
      if (SCV3_normalize_(taskName) === 'NGỦ KHUYA') continue;

      const details = master[SCV3_normalize_(taskName)];
      if (!details) throw new Error('Không tìm thấy task phụ "'+taskName+'" trong bảng A1:F25 của sheet '+daySheet.getName()+'.');
      if (!Number.isFinite(details.duration) || details.duration <= 0) throw new Error('DURING ở cột E không hợp lệ cho task phụ: '+taskName+' ('+daySheet.getName()+').');

      const durationMinutes = SCV3_number_(values[r][slot.durationOffset]);
      if (!Number.isFinite(durationMinutes) || durationMinutes <= 0) {
        throw new Error('Thời lượng phút tại '+daySheet.getName()+'!'+SCV3_columnLetter_(8+slot.durationOffset)+(firstRow+r)+' không hợp lệ cho task "'+taskName+'".');
      }

      const groupKey = SCV3_normalize_(details.className || '(KHÔNG PHÂN NHÓM)');
      if (!groups.has(groupKey)) groups.set(groupKey,[]);
      groups.get(groupKey).push({taskName:taskName,details:details,durationMinutes:durationMinutes});
    }
  }

  // Bắt đầu sau task chính kết thúc muộn nhất; bỏ qua sự kiện ngủ đêm.
  let cursorTime = null;
  (primaryPlan || []).forEach(item => {
    if (item.type === 'TASK' && (cursorTime === null || item.end > cursorTime)) cursorTime = item.end;
  });
  if (cursorTime === null) {
    const fallback = new Date(date);
    fallback.setHours(Math.floor(SCV3.START_HOUR),Math.round((SCV3.START_HOUR%1)*60),0,0);
    cursorTime = fallback.getTime();
  }

  const plan = [];
  let groupIndex = 0;
  for (const tasks of groups.values()) {
    // Chỉ nghỉ 15 phút khi chuyển sang nhóm CLASS tiếp theo.
    if (groupIndex > 0) cursorTime += 15*60*1000;

    for (const task of tasks) {
      const start = cursorTime;
      const end = start + task.durationMinutes*60*1000;
      const key = SCV3_normalize_(task.taskName);
      occurrence[key] = (occurrence[key] || 0)+1;
      const id = SCV3_makeId_(date,'SECONDARY|'+task.taskName,occurrence[key]);
      const description = SCV3.MARKER+id+']]'+
        '\n🏫 CLASS: '+task.details.className+
        '\n📌 CÔNG VIỆC: '+task.details.name+
        '\n📝 NỘI DUNG: '+task.details.content+
        '\n⏱️ DURING: '+task.details.duration;
      plan.push({
        id:id,
        type:'SECONDARY_TASK',
        name:task.details.name,
        title:task.details.name,
        description:description,
        start:start,
        end:end,
        color:SCV3.SECONDARY_COLOR
      });
      cursorTime = end;
    }
    groupIndex++;
  }
  return plan;
}
function SCV3_columnLetter_(column) {
  let n = column, result = '';
  while (n > 0) {
    const remainder = (n-1)%26;
    result = String.fromCharCode(65+remainder)+result;
    n = Math.floor((n-1)/26);
  }
  return result;
}
function SCV3_buildDayPlan_(master,ready,date,gapMinutes,sleepStart,sleepDuration) {
  const tasks = [];
  const occurrence = {};
  for (let col=SCV3.TASK_FIRST_COL;col<=SCV3.TASK_LAST_COL;col+=SCV3.TASK_STEP) {
    const taskName = String(ready[col-SCV3.TASK_FIRST_COL] || '').trim();
    if (!taskName) continue;
    const key = SCV3_normalize_(taskName);
    const details = master[key];
    if (!details) throw new Error('KHÔNG TÌM THẤY MASTER TASK: '+taskName+'\nREADY: '+SCV3_DAYS[date.getDay() === 0 ? 6 : date.getDay()-1]+'\nVui lòng kiểm tra tên tại MASTER cột C.');
    if (!Number.isFinite(details.duration) || details.duration <= 0) throw new Error('DURING không hợp lệ: '+taskName);
    occurrence[key] = (occurrence[key] || 0)+1;
    tasks.push({name:taskName,details:details,occurrence:occurrence[key]});
  }
  const plan = [];
  const sleepParts = sleepStart.split(':').map(Number);
  const sleepDate = new Date(date);
  sleepDate.setHours(sleepParts[0],sleepParts[1],0,0);
  const sleepEnd = new Date(sleepDate.getTime()+sleepDuration*60*60*1000);
  const sleepId = SCV3_makeId_(date,'SLEEP',1);
  plan.push({
    id:sleepId,
    type:'SLEEP',
    name:SCV3.SLEEP_TITLE,
    title:SCV3.SLEEP_TITLE,
    description:SCV3.MARKER+sleepId+']]\n🌙 NGỦ ĐÊM\n📅 NGÀY: '+Utilities.formatDate(date,SCV3.TIMEZONE,'dd/MM/yyyy'),
    start:sleepDate.getTime(),
    end:sleepEnd.getTime(),
    color:CalendarApp.EventColor.GRAY
  });
  let cursor = new Date(date);
  cursor.setHours(Math.floor(SCV3.START_HOUR),Math.round((SCV3.START_HOUR%1)*60),0,0);
  tasks.forEach((task,index) => {
    const details = task.details;
    if (index > 0) cursor = new Date(cursor.getTime()+gapMinutes*60*1000);
    const start = new Date(cursor);
    const end = new Date(start.getTime()+details.duration*60*60*1000);
    const id = SCV3_makeId_(date,task.name,task.occurrence);
    const classUpper = details.className.toUpperCase();
    const category = String(details.category || '').toUpperCase();
    let icon = '';
    if (classUpper === 'SYSTEM' || category.includes('SYSTEM')) icon = '⚙️';
    else if (category.includes('BẢN SẮC')) icon = '🎭';
    else if (category.includes('ĐẠO ĐỒ')) icon = '🧘';
    else if (category.includes('SỰ NGHIỆP')) icon = '💼';
    const title = (icon ? icon+' ' : '')+task.name;
    const description = SCV3_formatDescription_(id,details);
    let color = null;
    if (details.gi !== 0) color = CalendarApp.EventColor.MAUVE;
    else if (classUpper === 'SYSTEM') color = CalendarApp.EventColor.RED;
    else if (classUpper === 'KNOWLEDGES' || classUpper === 'CASUAL SKILLS' || classUpper === 'NỘI TẠI') color = CalendarApp.EventColor.GREEN;
    else if (classUpper === 'DƯỠNG SINH' || classUpper === 'SIÊU SINH' || classUpper === 'TRƯỜNG SINH') color = CalendarApp.EventColor.YELLOW;
    plan.push({
      id:id,
      type:'TASK',
      name:task.name,
      title:title,
      description:description,
      start:start.getTime(),
      end:end.getTime(),
      color:color
    });
    cursor = end;
  });
  return plan;
}
function SCV3_formatDescription_(id,details) {
  const raw = details.content || '';
  const matches = raw.match(/\[(.*?)\]/g);
  let processedContent = '';
  if (matches && matches.length) {
    processedContent = matches.map(m => '-> '+m.replace(/^\[/,'').replace(/\]$/,'').trim()).join('\n');
  } else {
    processedContent = '-> '+raw;
  }
  return SCV3.MARKER+id+']]\n🏫 CLASS: '+details.className+'\n📌 CÔNG VIỆC: '+details.name+'\n📝 NỘI DUNG: \n'+processedContent+'\n📊 PR: '+details.pr+'\n⚙️ GI: '+details.gi+'\n⏱️ DURING: '+details.duration;
}
function SCV3_getManagedId_(event) {
  const description = event.getDescription() || '';
  const match = description.match(/\[\[SCV2_ID:([^\]]+)\]\]/);
  return match ? match[1] : null;
}
function SCV3_findLegacyEvent_(events,desired) {
  const desiredDateKey = SCV3_dateKey_(new Date(desired.start));
  const candidates = [];
  events.forEach(event => {
    if (SCV3_getManagedId_(event)) return;
    if (SCV3_dateKey_(event.getStartTime()) !== desiredDateKey) return;
    const description = event.getDescription() || '';
    if (desired.type === 'SLEEP') {
      if (event.getTitle() === SCV3.SLEEP_TITLE) candidates.push(event);
      return;
    }
    const match = description.match(/📌 CÔNG VIỆC:\s*(.+)/);
    if (match && SCV3_normalize_(match[1]) === SCV3_normalize_(desired.name)) candidates.push(event);
  });
  if (!candidates.length) return null;
  candidates.sort((a,b) => Math.abs(a.getStartTime().getTime()-desired.start)-Math.abs(b.getStartTime().getTime()-desired.start));
  return candidates[0];
}
function SCV3_makeId_(date,name,occurrence) {
  const text = SCV3_dateKey_(date)+'|'+SCV3_normalize_(name)+'|'+occurrence;
  const bytes = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,text);
  const hash = bytes.map(b => ('0'+((b+256)%256).toString(16)).slice(-2)).join('');
  return hash.substring(0,24);
}
function SCV3_normalize_(value) {
  return String(value || '').normalize('NFC').trim().replace(/\s+/g,' ').toUpperCase();
}
function SCV3_number_(value) {
  if (typeof value === 'number') return value;
  const parsed = parseFloat(String(value || '').replace(',','.'));
  return isNaN(parsed) ? 0 : parsed;
}
function SCV3_dateKey_(date) {
  return Utilities.formatDate(date,SCV3.TIMEZONE,'yyyyMMdd');
}
function SCV3_parseDate_(value,display) {
  if (value instanceof Date && !isNaN(value.getTime())) {
    const d = new Date(value);
    d.setHours(0,0,0,0);
    return d;
  }
  const match = String(display || '').match(/^(\d{1,2})[\/.-](\d{1,2})[\/.-](\d{4})$/);
  if (match) {
    const d = new Date(Number(match[3]),Number(match[2])-1,Number(match[1]));
    d.setHours(0,0,0,0);
    return d;
  }
  return null;
}
