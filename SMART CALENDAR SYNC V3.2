        const checkbox = document.createElement('input');
        checkbox.type = 'checkbox';
        checkbox.className = 'daycb';
        checkbox.value = day.index;
        checkbox.checked = day.valid;
        checkbox.disabled = !day.valid;
        const name = document.createElement('span');
        name.textContent = day.label;
        const date = document.createElement('span');
        date.className = 'day-date';
        date.textContent = day.date;
        label.appendChild(checkbox);
        label.appendChild(name);
        label.appendChild(date);
        $('days').appendChild(label);
      });
      $('all').checked = days.some(d => d.valid) && days.every(d => d.valid);
      $('start').disabled = !days.some(d => d.valid);
      $('start').textContent = 'BẮT ĐẦU ĐỒNG BỘ V3.1';
      updateAllCheckbox();
    }).withFailureHandler(showError).SCV3_getDays();
  }
  function updateAllCheckbox(){
    const boxes = [...document.querySelectorAll('.daycb')];
    const checked = boxes.filter(cb => cb.checked).length;
    $('all').checked = boxes.length > 0 && checked === boxes.length;
    $('all').indeterminate = checked > 0 && checked < boxes.length;
  }
  $('all').addEventListener('change',function(){
    document.querySelectorAll('.daycb').forEach(cb => {
      if (!cb.disabled) cb.checked = this.checked;
    });
  });
  $('days').addEventListener('change',function(e){
    if (e.target.classList.contains('daycb')) updateAllCheckbox();
  });
  $('start').addEventListener('click',function(){
    if (running) return;
    const selectedDays = [...document.querySelectorAll('.daycb:checked')].map(cb => Number(cb.value));
    if (!selectedDays.length){
      alert('Vui lòng chọn ít nhất một ngày.');
      return;
    }
    const options = {
      selectedDays:selectedDays,
      clearOld:$('clear').checked,
      createSync:$('create').checked,
      gapMinutes:Number($('gap').value),
      sleepStart:$('sleepStart').value,
      sleepDuration:Number($('sleepDuration').value)
    };
    if (!options.clearOld && !options.createSync){
      alert('Vui lòng chọn ít nhất một chức năng.');
      return;
    }
    if (options.createSync){
      if (!Number.isFinite(options.gapMinutes) || options.gapMinutes < 0 || options.gapMinutes > 1440){
        alert('Khoảng nghỉ phải từ 0 đến 1440 phút.');
        return;
      }
      if (!Number.isFinite(options.sleepDuration) || options.sleepDuration <= 0 || options.sleepDuration > 24){
        alert('Thời lượng ngủ phải lớn hơn 0 và không quá 24 giờ.');
        return;
      }
      if (!options.sleepStart || !/^([01]\\d|2[0-3]):[0-5]\\d$/.test(options.sleepStart)){
        alert('Giờ bắt đầu ngủ không hợp lệ.');
        return;
      }
    }
    if (options.clearOld){
      const message = options.createSync
        ? 'Xóa toàn bộ task và sự kiện ngủ đêm do Smart Calendar quản lý trong các ngày đã chọn, sau đó tạo lại lịch theo thiết lập hiện tại?'
        : 'Xóa toàn bộ task và sự kiện ngủ đêm do Smart Calendar quản lý trong các ngày đã chọn?';
      if (!confirm(message)) return;
    }
    running = true;
    $('setup').style.display = 'none';
    $('progress').style.display = 'block';
    $('message').textContent = 'Đang xử lý '+selectedDays.length+' ngày...';
    $('status2').textContent = 'Đang đọc dữ liệu và chuẩn bị Calendar...';
    log('BẮT ĐẦU SMART CALENDAR SYNC V3.2');
    log('Số ngày được chọn: '+selectedDays.length);
    log('Dọn lịch cũ: '+(options.clearOld ? 'BẬT' : 'TẮT'));
    log('Tạo/cập nhật: '+(options.createSync ? 'BẬT' : 'TẮT'));
    log('Cơ chế xóa: tối đa 20 lệnh DELETE trong một HTTP batch request.');
    log('Cơ chế tạo/cập nhật: tối đa 20 lệnh INSERT/PATCH trong một HTTP batch request.');
    if (options.clearOld) log('Xóa tất cả task và sự kiện ngủ đêm thuộc ngày đã chọn.');
    if (options.createSync){
      log('Khoảng nghỉ: '+options.gapMinutes+' phút');
      log('Giờ ngủ: '+options.sleepStart);
      log('Thời lượng ngủ: '+options.sleepDuration+' giờ');
    }
    google.script.run.withSuccessHandler(handleBatch).withFailureHandler(showError).SCV3_sync(options);
  });
  function handleBatch(data){
    if (!data) return showError('Không nhận được phản hồi từ máy chủ.');
    if (data.done) return finish(data);
    const total = Number(data.total || 0);
    const progress = Number(data.progress || 0);
    const percent = total ? Math.round(progress/total*100) : 100;
    $('bar2').style.width = percent+'%';
    $('status2').textContent = 'Đã xử lý '+progress+'/'+total+' thao tác ('+percent+'%).';
    if (data.paused){
      if (data.retryable === false){
        running = false;
        $('message').textContent = '⛔ ĐÃ DỪNG ĐỂ TRÁNH BÁO THÀNH CÔNG SAI';
        $('error').style.display = 'block';
        $('error').textContent = data.error || 'Không xác minh được thao tác trên Google Calendar.';
        $('close').style.display = 'block';
        log('DỪNG AN TOÀN: '+$('error').textContent);
        return;
      }
      log('Google Calendar đang giới hạn thao tác. Đã lưu tiến độ '+progress+'/'+total+'. Sẽ tự thử lại sau 30 giây.');
      $('message').textContent = '⏸️ Tạm nghỉ để tránh giới hạn Google Calendar. Tiến độ đã được lưu.';
      setTimeout(function(){
        google.script.run.withSuccessHandler(handleBatch).withFailureHandler(function(err){
          log('Lỗi khi tiếp tục: '+(err && err.message ? err.message : err));
          setTimeout(function(){
            google.script.run.withSuccessHandler(handleBatch).withFailureHandler(showError).SCV3_continueSync(data.token);
          },30000);
        }).SCV3_continueSync(data.token);
      },30000);
      return;
    }
    log('Đã xử lý '+progress+'/'+total+' thao tác. Đang chuyển sang lô tiếp theo...');
    $('message').textContent = 'Đang đồng bộ... '+percent+'%';
    setTimeout(function(){
      google.script.run.withSuccessHandler(handleBatch).withFailureHandler(showError).SCV3_continueSync(data.token);
    },500);
  }
  function finish(data){
    running = false;
    const s = data.stats;
    $('bar2').style.width = '100%';
    $('status2').textContent = '✅ Hoàn tất đồng bộ.';
    $('message').textContent = '🎉 SMART CALENDAR SYNC V3.2 HOÀN TẤT!';
    $('result').style.display = 'block';
    let result = '<b>📊 KẾT QUẢ ĐỒNG BỘ</b><br>📅 Số ngày: '+data.days+'<br>🗑️ Đã xóa: '+s.deleted+'<br>🆕 Tạo mới: '+s.created+'<br>🔄 Cập nhật: '+s.updated+'<br>⏭️ Không thay đổi: '+s.unchanged;
    if (data.settings.createSync){
      result += '<hr>⏱️ Khoảng nghỉ: '+data.settings.gapMinutes+' phút<br>💤 Giờ ngủ: '+data.settings.sleepStart+'<br>🌙 Thời lượng ngủ: '+data.settings.sleepDuration+' giờ';
    }
    $('result').innerHTML = result;
    log('--------------------------------');
    log('TỔNG KẾT:');
    log('Đã xóa: '+s.deleted);
    log('Tạo mới: '+s.created);
    log('Cập nhật: '+s.updated);
    log('Không thay đổi: '+s.unchanged);
    if (data.actions && data.actions.length){
      log('--------------------------------');
      log('CHI TIẾT XỬ LÝ:');
      data.actions.forEach(function(a){
        let prefix = '';
        if (a.action === 'CREATED') prefix = '🆕 TẠO MỚI';
        if (a.action === 'UPDATED') prefix = '🔄 CẬP NHẬT';
        if (a.action === 'UNCHANGED') prefix = '⏭ GIỮ NGUYÊN';
        if (a.action === 'DELETED') prefix = '🗑 XÓA';
        log(prefix+': '+a.title);
      });
    }
    log('================================');
    log('HOÀN TẤT SMART CALENDAR SYNC V3.2.');
    $('close').style.display = 'block';
  }
  $('close').addEventListener('click',function(){
    google.script.host.close();
  });
  loadDays();
})();
</script>
</body>
</html>
`;
}
