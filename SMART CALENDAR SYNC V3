
/***************************************************************
 * SMART CALENDAR SYNC V2.2
 * READY DATE: M16:M22
 * READY TASK: O,Q,S,U,W,Y,AA,AC,AE,AG,AI,AK
 * MASTER: B:G, bắt đầu từ hàng 3
 *
 * PR LUÔN LẤY TỪ MASTER CỘT E
 *
 * - Chọn từng ngày độc lập
 * - Đồng bộ theo thứ tự READY
 * - Tiến trình thực tế theo từng nhóm 3 sự kiện
 * - Chống trùng bằng SCV2_ID
 * - Cập nhật sự kiện đã tồn tại
 * - Chỉ xóa khi người dùng bật tùy chọn
 * - Không xóa lịch cá nhân
 ***************************************************************/

const SCV2 = {
  SHEET: 'TUẦN',

  MASTER_ROW: 3,

  READY_FIRST_ROW: 16,
  READY_LAST_ROW: 22,

  DATE_COL: 13, // M

  TASK_FIRST_COL: 15, // O
  TASK_LAST_COL: 37,  // AK
  TASK_STEP: 2,

  START_HOUR: 7.5,

  SLEEP_START: 2,
  SLEEP_DURATION: 5.5,
  SLEEP_TITLE: '💤 Ngủ đêm',

  MARKER: '[[SCV2_ID:',

  BATCH_SIZE: 3,

  CACHE_SECONDS: 21600,

  TIMEZONE: Session.getScriptTimeZone()
};

const SCV2_DAYS = [
  'THỨ HAI',
  'THỨ BA',
  'THỨ TƯ',
  'THỨ NĂM',
  'THỨ SÁU',
  'THỨ BẢY',
  'CHỦ NHẬT'
];


/***************************************************************
 * 1. MỞ GIAO DIỆN
 ***************************************************************/

function showCalendarSyncDialogV2() {

  const html = HtmlService
    .createHtmlOutput(SCV2_getHTML_())
    .setWidth(650)
    .setHeight(780);

  SpreadsheetApp.getUi().showModalDialog(
    html,
    'SMART CALENDAR SYNC V2.2'
  );

}


/***************************************************************
 * 2. LẤY DANH SÁCH NGÀY TỪ M16:M22
 ***************************************************************/

function SCV2_getDaysV22() {

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(SCV2.SHEET);

  if (!sheet) {
    throw new Error('Không tìm thấy sheet TUẦN.');
  }

  const values = sheet.getRange(
    SCV2.READY_FIRST_ROW,
    SCV2.DATE_COL,
    7,
    1
  ).getValues();

  const displays = sheet.getRange(
    SCV2.READY_FIRST_ROW,
    SCV2.DATE_COL,
    7,
    1
  ).getDisplayValues();

  return values.map((r, i) => {

    const date = SCV2_parseDate_(r[0], displays[i][0]);

    return {
      index: i,
      valid: !!date,
      label: SCV2_DAYS[i],
      date: date
        ? Utilities.formatDate(
            date,
            SCV2.TIMEZONE,
            'dd/MM/yyyy'
          )
        : 'Chưa có ngày',
      row: SCV2.READY_FIRST_ROW + i
    };

  });

}


/***************************************************************
 * 3. KHỞI TẠO MỘT NGÀY
 ***************************************************************/

function SCV2_beginDayV22(dayIndex, options) {

  dayIndex = Number(dayIndex);

  if (
    !Number.isInteger(dayIndex) ||
    dayIndex < 0 ||
    dayIndex > 6
  ) {
    throw new Error('Ngày được chọn không hợp lệ.');
  }

  options = options || {};

  const clearOld = options.clearOld === true;
  const createSync = options.createSync === true;

  if (!clearOld && !createSync) {
    throw new Error('Bạn chưa chọn chức năng đồng bộ.');
  }

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(SCV2.SHEET);

  if (!sheet) {
    throw new Error('Không tìm thấy sheet TUẦN.');
  }

  const row = SCV2.READY_FIRST_ROW + dayIndex;

  const dateValue = sheet.getRange(
    row,
    SCV2.DATE_COL
  ).getValue();

  const dateDisplay = sheet.getRange(
    row,
    SCV2.DATE_COL
  ).getDisplayValue();

  const date = SCV2_parseDate_(
    dateValue,
    dateDisplay
  );

  if (!date) {
    throw new Error(
      'Ngày tại M' + row + ' không hợp lệ.'
    );
  }

  let plan = [];

  if (createSync) {

    const master = SCV2_buildMasterIndex_(sheet);

    plan = SCV2_buildDayPlan_(
      sheet,
      master,
      dayIndex,
      date
    );

  }

  const token = Utilities.getUuid();

  const desiredIds = plan.map(x => x.id);

  const state = {
    dayIndex: dayIndex,
    dateKey: SCV2_dateKey_(date),

    clearOld: clearOld,
    createSync: createSync,

    desiredIds: desiredIds,
    plan: plan,

    stats: {
      created: 0,
      updated: 0,
      unchanged: 0,
      deleted: 0,
      skipped: 0
    }
  };

  const json = JSON.stringify(state);

  if (json.length > 95000) {
    throw new Error(
      'Dữ liệu đồng bộ quá lớn để lưu trạng thái.'
    );
  }

  CacheService.getUserCache().put(
    'SCV2_' + token,
    json,
    SCV2.CACHE_SECONDS
  );

  return {
    token: token,
    total: plan.length,
    day: SCV2_DAYS[dayIndex],
    date: Utilities.formatDate(
      date,
      SCV2.TIMEZONE,
      'dd/MM/yyyy'
    )
  };

}


/***************************************************************
 * 4. XỬ LÝ TỪNG NHÓM CÔNG VIỆC
 ***************************************************************/

function SCV2_processBatchV22(token, offset) {

  const lock = LockService.getScriptLock();

  if (!lock.tryLock(10000)) {
    throw new Error(
      'Hệ thống đang có một tiến trình đồng bộ khác. ' +
      'Vui lòng thử lại.'
    );
  }

  try {

    const cache = CacheService.getUserCache();

    const cacheKey = 'SCV2_' + token;

    const raw = cache.get(cacheKey);

    if (!raw) {
      throw new Error(
        'Phiên đồng bộ đã hết hạn. Vui lòng chạy lại.'
      );
    }

    const state = JSON.parse(raw);

    offset = Number(offset) || 0;

    const calendar = CalendarApp.getDefaultCalendar();

    const date = SCV2_parseDateKey_(
      state.dateKey
    );

    const dayStart = new Date(date);
    dayStart.setHours(0, 0, 0, 0);

    const dayEnd = new Date(dayStart);
    dayEnd.setDate(dayEnd.getDate() + 1);

    const plan = state.plan;

    const endIndex = Math.min(
      offset + SCV2.BATCH_SIZE,
      plan.length
    );

    const actions = [];

    /*******************************************************
     * TẠO / CẬP NHẬT TỪNG SỰ KIỆN
     *******************************************************/

    for (let i = offset; i < endIndex; i++) {

      const item = plan[i];

      const events = calendar.getEvents(
        dayStart,
        dayEnd
      );

      let event = null;

      // Tìm sự kiện có ID chính xác.

      for (const e of events) {

        if (
          SCV2_getManagedId_(e) === item.id
        ) {

          event = e;
          break;

        }

      }

      // Nếu chưa có ID V2, tìm sự kiện V1.

      if (!event) {

        event = SCV2_findLegacyEvent_(
          events,
          item
        );

      }

      if (!event) {

        event = calendar.createEvent(
          item.title,
          new Date(item.start),
          new Date(item.end),
          {
            description: item.description
          }
        );

        state.stats.created++;

        actions.push({
          action: 'CREATED',
          title: item.title
        });

      } else {

        const same =
          event.getTitle() === item.title &&
          (event.getDescription() || '') === item.description &&
          event.getStartTime().getTime() ===
            Number(item.start) &&
          event.getEndTime().getTime() ===
            Number(item.end);

        if (same) {

          state.stats.unchanged++;

          actions.push({
            action: 'UNCHANGED',
            title: item.title
          });

        } else {

          event.setTitle(item.title);

          event.setTime(
            new Date(item.start),
            new Date(item.end)
          );

          event.setDescription(
            item.description
          );

          state.stats.updated++;

          actions.push({
            action: 'UPDATED',
            title: item.title
          });

        }

      }

      if (item.color) {

        try {
          event.setColor(item.color);
        } catch (e) {
          // Không để lỗi màu làm gián đoạn đồng bộ.
        }

      }

    }


    /*******************************************************
     * DỌN LỊCH CŨ
     *
     * CHỈ THỰC HIỆN KHI clearOld = true.
     * KHÔNG XÓA DUPLICATE KHI clearOld = false.
     *******************************************************/

    const finished = endIndex >= plan.length;

    if (finished && state.clearOld) {

      const events = calendar.getEvents(
        dayStart,
        dayEnd
      );

      const desired = new Set(state.desiredIds);

      const seen = new Set();

      events.forEach(event => {

        const id = SCV2_getManagedId_(event);

        if (!id) return;

        // Chỉ thao tác với sự kiện có mã V2.

        const shouldDelete =
          !desired.has(id) ||
          seen.has(id);

        if (shouldDelete) {

          event.deleteEvent();

          state.stats.deleted++;

        } else {

          seen.add(id);

        }

      });

    }


    // Lưu tiến trình.

    cache.put(
      cacheKey,
      JSON.stringify(state),
      SCV2.CACHE_SECONDS
    );

    return {

      offset: offset,
      nextOffset: endIndex,

      processed: endIndex,
      total: plan.length,

      finished: finished,

      actions: actions,

      stats: state.stats,

      clearOld: state.clearOld

    };

  } finally {

    lock.releaseLock();

  }

}


/***************************************************************
 * 5. MASTER DATABASE
 ***************************************************************/

function SCV2_buildMasterIndex_(sheet) {

  const lastRow = sheet.getLastRow();

  if (lastRow < SCV2.MASTER_ROW) {
    throw new Error('MASTER DATABASE đang trống.');
  }

  const count =
    lastRow - SCV2.MASTER_ROW + 1;

  const values = sheet.getRange(
    SCV2.MASTER_ROW,
    1,
    count,
    7
  ).getValues();

  const formulas = sheet.getRange(
    SCV2.MASTER_ROW,
    1,
    count,
    1
  ).getFormulas();

  const map = {};

  let currentCategory = '';

  for (let i = 0; i < values.length; i++) {

    const r = values[i];

    const aValue = String(r[0] || '').trim();

    const aFormula = String(
      formulas[i][0] || ''
    );

    const categoryMatch = (
      aFormula + ' ' + aValue
    ).match(
      /\[\s*Phân loại\s*[:]\s*([^\]]+)\s*\]/i
    );

    if (categoryMatch) {

      currentCategory = categoryMatch[1].trim();

    } else if (aValue) {

      currentCategory = aValue;

    }

    const className = String(
      r[1] || ''
    ).trim();

    const taskName = String(
      r[2] || ''
    ).trim();

    if (!taskName) continue;

    const key = SCV2_normalize_(taskName);

    if (map[key]) continue;

    map[key] = {

      name: taskName,

      className: className,

      content: String(
        r[3] || ''
      ).trim(),

      // PR LUÔN LẤY CỘT E.
      pr: SCV2_number_(r[4]),

      gi: SCV2_number_(r[5]),

      duration: SCV2_number_(r[6]),

      category:
        className.toUpperCase() === 'SYSTEM'
          ? 'SYSTEM'
          : currentCategory

    };

  }

  return map;

}


/***************************************************************
 * 6. ĐỌC READY VÀ LẬP LỊCH
 ***************************************************************/

function SCV2_buildDayPlan_(
  sheet,
  master,
  dayIndex,
  date
) {

  const row = SCV2.READY_FIRST_ROW + dayIndex;

  // Đọc toàn bộ READY một lần.
  const ready = sheet.getRange(
    row,
    SCV2.TASK_FIRST_COL,
    1,
    SCV2.TASK_LAST_COL -
      SCV2.TASK_FIRST_COL + 1
  ).getDisplayValues()[0];

  const tasks = [];

  const occurrence = {};

  for (
    let col = SCV2.TASK_FIRST_COL;
    col <= SCV2.TASK_LAST_COL;
    col += SCV2.TASK_STEP
  ) {

    const taskName = String(
      ready[col - SCV2.TASK_FIRST_COL] || ''
    ).trim();

    if (!taskName) continue;

    const key = SCV2_normalize_(taskName);

    const details = master[key];

    if (!details) {

      throw new Error(
        'KHÔNG TÌM THẤY MASTER TASK: ' +
        taskName +
        '\nVị trí READY: ' +
        sheet.getRange(row, col).getA1Notation() +
        '\nKiểm tra tên tại cột C của MASTER.'
      );

    }

    if (details.duration <= 0) {

      throw new Error(
        'DURING không hợp lệ: ' + taskName
      );

    }

    occurrence[key] =
      (occurrence[key] || 0) + 1;

    tasks.push({

      name: taskName,

      details: details,

      occurrence: occurrence[key]

    });

  }


  const plan = [];


  /*******************************************************
   * SỰ KIỆN NGỦ ĐÊM
   *******************************************************/

  const sleepStart = new Date(date);

  sleepStart.setHours(
    SCV2.SLEEP_START,
    0,
    0,
    0
  );

  const sleepEnd = new Date(sleepStart);

  sleepEnd.setMinutes(
    sleepEnd.getMinutes() +
    SCV2.SLEEP_DURATION * 60
  );

  const sleepId = SCV2_makeId_(
    date,
    'SLEEP',
    1
  );

  plan.push({

    id: sleepId,

    title: SCV2.SLEEP_TITLE,

    description:
      SCV2.MARKER + sleepId + ']]\n' +
      '🌙 NGỦ ĐÊM\n' +
      '📅 NGÀY: ' +
      Utilities.formatDate(
        date,
        SCV2.TIMEZONE,
        'dd/MM/yyyy'
      ),

    start: sleepStart.getTime(),

    end: sleepEnd.getTime(),

    color: CalendarApp.EventColor.GRAY

  });


  /*******************************************************
   * CÁC TASK READY
   *******************************************************/

  let currentTime = SCV2.START_HOUR;

  tasks.forEach((task, index) => {

    const details = task.details;

    if (index > 0) {

      currentTime +=
        details.duration <= 2
          ? 0.25
          : 0.5;

    }

    const start = new Date(date);

    start.setMinutes(
      Math.round(currentTime * 60)
    );

    const end = new Date(start);

    end.setMinutes(
      end.getMinutes() +
      Math.round(details.duration * 60)
    );

    const id = SCV2_makeId_(
      date,
      task.name,
      task.occurrence
    );

    const classUpper =
      details.className.toUpperCase();

    const category =
      details.category.toUpperCase();

    let icon = '';

    if (
      classUpper === 'SYSTEM' ||
      category.includes('SYSTEM')
    ) {

      icon = '⚙️';

    } else if (category.includes('BẢN SẮC')) {

      icon = '🎭';

    } else if (category.includes('ĐẠO ĐỒ')) {

      icon = '🧘';

    } else if (category.includes('SỰ NGHIỆP')) {

      icon = '💼';

    }

    const title =
      (icon ? icon + ' ' : '') + task.name;

    const description =
      SCV2_formatDescription_(
        id,
        details
      );

    let color = null;

    if (details.gi !== 0) {

      color = CalendarApp.EventColor.MAUVE;

    } else if (classUpper === 'SYSTEM') {

      color = CalendarApp.EventColor.RED;

    } else if (
      classUpper === 'KNOWLEDGES' ||
      classUpper === 'CASUAL SKILLS' ||
      classUpper === 'NỘI TẠI'
    ) {

      color = CalendarApp.EventColor.GREEN;

    } else if (
      classUpper === 'DƯỠNG SINH' ||
      classUpper === 'SIÊU SINH' ||
      classUpper === 'TRƯỜNG SINH'
    ) {

      color = CalendarApp.EventColor.YELLOW;

    }

    plan.push({

      id: id,

      title: title,

      description: description,

      start: start.getTime(),

      end: end.getTime(),

      color: color

    });

    currentTime += details.duration;

  });

  return plan;

}


/***************************************************************
 * 7. DESCRIPTION GOOGLE CALENDAR
 ***************************************************************/

function SCV2_formatDescription_(id, details) {

  const raw = details.content || '';

  const matches = raw.match(/\[(.*?)\]/g);

  let processedContent = '';

  if (matches && matches.length) {

    processedContent = matches.map(m => {

      const clean = m
        .replace(/^\[/, '')
        .replace(/\]$/, '')
        .trim();

      return '\n-> ' + clean;

    }).join('');

  } else {

    processedContent = '\n-> ' + raw;

  }

  return (
    SCV2.MARKER + id + ']]\n' +

    '🏫 CLASS: ' + details.className + '\n' +

    '📌 CÔNG VIỆC: ' + details.name + '\n' +

    '📝 NỘI DUNG: ' + processedContent + '\n' +

    '📊 PR: ' + details.pr + '\n' +

    '⚙️ GI: ' + details.gi + '\n' +

    '⏱️ DURING: ' + details.duration
  );

}


/***************************************************************
 * 8. NHẬN DIỆN ID V2
 ***************************************************************/

function SCV2_getManagedId_(event) {

  const description =
    event.getDescription() || '';

  const match = description.match(
    /\[\[SCV2_ID:([^\]]+)\]\]/
  );

  return match ? match[1] : null;

}


/***************************************************************
 * 9. NHẬN DIỆN SỰ KIỆN V1
 ***************************************************************/

function SCV2_findLegacyEvent_(events, desired) {

  const candidates = [];

  events.forEach(event => {

    // Không nhận diện sự kiện V2 như sự kiện V1.
    if (SCV2_getManagedId_(event)) return;

    if (
      SCV2_dateKey_(event.getStartTime()) !==
      SCV2_dateKey_(new Date(desired.start))
    ) return;

    const description =
      event.getDescription() || '';

    if (desired.title === SCV2.SLEEP_TITLE) {

      if (
        event.getTitle() === SCV2.SLEEP_TITLE &&
        description.includes('Ngủ đêm của')
      ) {

        candidates.push(event);

      }

      return;

    }

    const match = description.match(
      /📌 CÔNG VIỆC:\s*(.+)/
    );

    if (!match) return;

    if (
      SCV2_normalize_(match[1]) ===
      SCV2_normalize_(
        desired.description.match(
          /📌 CÔNG VIỆC:\s*(.+)/
        )?.[1] || ''
      )
    ) {

      candidates.push(event);

    }

  });

  if (!candidates.length) return null;

  candidates.sort((a, b) => {

    const da = Math.abs(
      a.getStartTime().getTime() -
      Number(desired.start)
    );

    const db = Math.abs(
      b.getStartTime().getTime() -
      Number(desired.start)
    );

    return da - db;

  });

  return candidates[0];

}


/***************************************************************
 * 10. TẠO ID ỔN ĐỊNH
 ***************************************************************/

function SCV2_makeId_(date, name, occurrence) {

  const text =
    SCV2_dateKey_(date) + '|' +
    SCV2_normalize_(name) + '|' +
    occurrence;

  const bytes = Utilities.computeDigest(
    Utilities.DigestAlgorithm.SHA_256,
    text
  );

  const hash = bytes.map(b => {

    return ('0' + (
      (b + 256) % 256
    ).toString(16)).slice(-2);

  }).join('');

  return hash.substring(0, 24);

}


/***************************************************************
 * 11. HÀM HỖ TRỢ
 ***************************************************************/

function SCV2_normalize_(value) {

  return String(value || '')
    .normalize('NFC')
    .trim()
    .replace(/\s+/g, ' ')
    .toUpperCase();

}


function SCV2_number_(value) {

  if (typeof value === 'number') {
    return value;
  }

  const parsed = parseFloat(
    String(value || '')
      .replace(',', '.')
  );

  return isNaN(parsed) ? 0 : parsed;

}


function SCV2_dateKey_(date) {

  return Utilities.formatDate(
    date,
    SCV2.TIMEZONE,
    'yyyyMMdd'
  );

}


function SCV2_parseDateKey_(key) {

  const year = Number(key.substring(0, 4));
  const month = Number(key.substring(4, 6)) - 1;
  const day = Number(key.substring(6, 8));

  const date = new Date(year, month, day);
  date.setHours(0, 0, 0, 0);

  return date;

}


function SCV2_parseDate_(value, display) {

  if (
    value instanceof Date &&
    !isNaN(value.getTime())
  ) {

    const d = new Date(value);
    d.setHours(0, 0, 0, 0);

    return d;

  }

  const match = String(display || '').match(
    /^(\d{1,2})[\/.-](\d{1,2})[\/.-](\d{4})$/
  );

  if (match) {

    const d = new Date(
      Number(match[3]),
      Number(match[2]) - 1,
      Number(match[1])
    );

    d.setHours(0, 0, 0, 0);

    return d;

  }

  return null;

}


