.option {
  display:flex;
  align-items:center;
  margin:13px 0;
  font-size:13px;
  cursor:pointer;
}

button {
  border:0;
  cursor:pointer;
  font-weight:bold;
}

.start {
  width:100%;
  padding:15px;
  background:#1a73e8;
  color:white;
  border-radius:25px;
  font-size:14px;
}

.start:disabled {
  background:#999;
  cursor:not-allowed;
}

.note {
  font-size:11px;
  line-height:1.6;
  color:#777;
}

#progress {
  display:none;
}

.progress-bg {
  height:13px;
  background:#e8eaed;
  border-radius:15px;
  overflow:hidden;
  margin:10px 0;
}

.bar {
  height:100%;
  width:0%;
  transition:width .2s;
}

.blue {
  background:#4285f4;
}

.green {
  background:#34a853;
}

.status {
  font-size:12px;
  line-height:1.7;
  color:#555;
}

#message {
  padding:13px;
  background:#e8f0fe;
  border-radius:9px;
  font-size:13px;
  line-height:1.6;
  overflow-wrap:anywhere;
  margin-bottom:12px;
}

#liveLog {
  height:190px;
  overflow-y:auto;
  background:#202124;
  color:#e8eaed;
  border-radius:9px;
  padding:12px;
  font-size:11px;
  line-height:1.8;
  white-space:pre-wrap;
}

#result,
#error {
  display:none;
  padding:13px;
  margin-top:12px;
  border-radius:9px;
  font-size:13px;
  line-height:1.8;
  overflow-wrap:anywhere;
}

#result {
  background:#e6f4ea;
  color:#137333;
}

#error {
  background:#fce8e6;
  color:#c5221f;
}

.close {
  display:none;
  width:100%;
  padding:13px;
  border-radius:23px;
  margin-top:15px;
  background:#e8eaed;
}

#loading {
  text-align:center;
  padding:15px;
  color:#666;
  font-size:13px;
}

</style>
</head>

<body>

<h2>📅 SMART CALENDAR SYNC V2.2</h2>

<div id="setup">

  <div class="panel">

    <div class="heading">
      📆 CHỌN NGÀY ĐỒNG BỘ
    </div>

    <label class="all">
      <input type="checkbox" id="all" checked>
      CHỌN TẤT CẢ
    </label>

    <div id="days">
      <div id="loading">Đang đọc ngày từ M16:M22...</div>
    </div>

  </div>

  <div class="panel">

    <div class="heading">
      ⚙️ TÙY CHỌN
    </div>

    <label class="option">
      <input type="checkbox" id="clear">
      Dọn lịch V2 cũ không còn trong READY
    </label>

    <label class="option">
      <input type="checkbox" id="create" checked>
      Tạo / cập nhật lịch mới
    </label>

    <div class="note">
      Khi bỏ chọn dọn lịch cũ, hệ thống không xóa
      bất kỳ sự kiện nào, kể cả sự kiện trùng mã.
      Lịch cá nhân luôn được giữ nguyên.
    </div>

  </div>

  <button id="start" class="start" type="button" disabled>
    ĐANG TẢI DỮ LIỆU...
  </button>

</div>


<div id="progress">

  <div class="panel">

    <div class="heading">
      🗑️ DỌN LỊCH CŨ
    </div>

    <div class="progress-bg">
      <div id="bar1" class="bar blue"></div>
    </div>

    <div id="status1" class="status">
      Chưa thực hiện.
    </div>

    <hr style="border:0;border-top:1px solid #eee;margin:18px 0">

    <div class="heading">
      ✨ TẠO / CẬP NHẬT LỊCH
    </div>

    <div class="progress-bg">
      <div id="bar2" class="bar green"></div>
    </div>

    <div id="status2" class="status">
      Đang chuẩn bị...
    </div>

  </div>

  <div id="message">
    Đang khởi tạo...
  </div>

  <div class="panel">

    <div class="heading">
      🔎 NHẬT KÝ XỬ LÝ THỰC TẾ
    </div>

    <div id="liveLog">
      Đang khởi tạo hệ thống...
    </div>

  </div>

  <div id="result"></div>

  <div id="error"></div>

  <button id="close" class="close" type="button">
    ĐÓNG
  </button>

</div>


<script>

(function() {

  const $ = id => document.getElementById(id);

  let days = [];
  let selected = [];

  let totals = {
    created:0,
    updated:0,
    unchanged:0,
    deleted:0,
    skipped:0,
    total:0
  };

  let running = false;


  /********************************************************
   * LOG
   ********************************************************/

  function log(message) {

    const el = $('liveLog');

    const time = new Date().toLocaleTimeString();

    el.textContent +=
      '\\n[' + time + '] ' + message;

    el.scrollTop = el.scrollHeight;

  }


  /********************************************************
   * HIỂN THỊ LỖI
   ********************************************************/

  function showError(error) {

    running = false;

    $('message').textContent =
      '❌ ĐỒNG BỘ BỊ GIÁN ĐOẠN';

    $('error').style.display = 'block';

    $('error').textContent =
      error && error.message
        ? error.message
        : String(error);

    log('LỖI: ' + $('error').textContent);

    $('close').style.display = 'block';

  }


  /********************************************************
   * TẢI NGÀY M16:M22
   ********************************************************/

  function loadDays() {

    log('Đang đọc ngày từ M16:M22...');

    google.script.run

      .withSuccessHandler(function(data) {

        days = data || [];

        $('days').innerHTML = '';

        days.forEach(function(day) {

          const label = document.createElement('label');

          label.className = 'day';

          const checkbox = document.createElement('input');

          checkbox.type = 'checkbox';
          checkbox.className = 'daycb';
          checkbox.value = day.index;
          checkbox.checked = day.valid;
          checkbox.disabled = !day.valid;

          const name = document.createElement('span');

          name.textContent = day.label;

          const date = document.createElement('span');

          date.className = 'day-date';

          date.textContent = day.date;

          label.appendChild(checkbox);
          label.appendChild(name);
          label.appendChild(date);

          $('days').appendChild(label);

        });

        $('all').checked =
          days.every(d => d.valid);

        $('start').disabled =
          !days.some(d => d.valid);

        $('start').textContent =
          'BẮT ĐẦU ĐỒNG BỘ';

        log('Đã tải ' +
          days.filter(d => d.valid).length +
          '/7 ngày hợp lệ.');

        updateAllCheckbox();

      })

      .withFailureHandler(showError)

      .SCV2_getDaysV22();

  }


  /********************************************************
   * CHỌN TẤT CẢ / BỎ CHỌN
   ********************************************************/

  function updateAllCheckbox() {

    const boxes = document.querySelectorAll('.daycb');

    const checked = [...boxes].filter(
      cb => cb.checked
    ).length;

    $('all').checked =
      boxes.length > 0 &&
      checked === boxes.length;

    $('all').indeterminate =
      checked > 0 &&
      checked < boxes.length;

  }


  $('all').addEventListener('change', function() {

    document.querySelectorAll('.daycb')
      .forEach(cb => {

        if (!cb.disabled) {
          cb.checked = this.checked;
        }

      });

  });


  $('days').addEventListener('change', function(e) {

    if (e.target.classList.contains('daycb')) {
      updateAllCheckbox();
    }

  });


  /********************************************************
   * BẮT ĐẦU ĐỒNG BỘ
   ********************************************************/

  $('start').addEventListener('click', function() {

    if (running) return;

    selected = [
      ...document.querySelectorAll('.daycb:checked')
    ].map(cb => Number(cb.value));

    if (!selected.length) {

      alert('Vui lòng chọn ít nhất một ngày.');

      return;

    }

    const options = {

      clearOld: $('clear').checked,

      createSync: $('create').checked

    };

    if (!options.clearOld && !options.createSync) {

      alert('Vui lòng chọn ít nhất một chức năng.');

      return;

    }

    if (
      options.clearOld &&
      !options.createSync &&
      !confirm(
        'Bạn có chắc chắn muốn xóa toàn bộ sự kiện V2 ' +
        'trong các ngày đã chọn?'
      )
    ) return;

    running = true;

    $('setup').style.display = 'none';

    $('progress').style.display = 'block';

    $('start').disabled = true;

    log('BẮT ĐẦU ĐỒNG BỘ.');

    log('Số ngày được chọn: ' + selected.length);

    log('Dọn lịch cũ: ' +
      (options.clearOld ? 'BẬT' : 'TẮT'));

    log('Tạo/cập nhật: ' +
      (options.createSync ? 'BẬT' : 'TẮT'));

    processDay(0, options);

  });


  /********************************************************
   * XỬ LÝ TỪNG NGÀY
   ********************************************************/

  function processDay(dayPosition, options) {

    if (!running) return;

    if (dayPosition >= selected.length) {

      finish();

      return;

    }

    const dayIndex = selected[dayPosition];

    const day = days[dayIndex];

    $('message').textContent =
      'Đang khởi tạo ' +
      day.label + ' (' +
      day.date + ') — ' +
      (dayPosition + 1) +
      '/' + selected.length;

    log('--------------------------------');

    log('KHỞI TẠO ' +
      day.label + ' — ' + day.date);

    google.script.run

      .withSuccessHandler(function(data) {

        totals.total += data.total;

        log('Đã lập kế hoạch: ' +
          data.total + ' sự kiện.');

        log('Bắt đầu xử lý Calendar...');

        processBatch(
          dayPosition,
          dayIndex,
          data.token,
          0,
          data.total,
          options
        );

      })

      .withFailureHandler(showError)

      .SCV2_beginDayV22(
        dayIndex,
        options
      );

  }


  /********************************************************
   * XỬ LÝ THEO NHÓM 3 SỰ KIỆN
   ********************************************************/

  function processBatch(
    dayPosition,
    dayIndex,
    token,
    offset,
    total,
    options
  ) {

    if (!running) return;

    const day = days[dayIndex];

    $('message').textContent =
      'Đang xử lý ' + day.label +
      ' — ' + day.date +
      '\\nĐã xử lý: ' + offset +
      '/' + total + ' sự kiện';

    google.script.run

      .withSuccessHandler(function(data) {

        const s = data.stats;

        // Cộng số liệu của nhóm vừa xử lý.
        // Mỗi kết quả được trả về theo từng batch.

        totals.created +=
          s.created - (totals._created || 0);

        totals.updated +=
          s.updated - (totals._updated || 0);

        totals.unchanged +=
          s.unchanged - (totals._unchanged || 0);

        totals.deleted +=
          s.deleted - (totals._deleted || 0);

        totals._created = s.created;
        totals._updated = s.updated;
        totals._unchanged = s.unchanged;
        totals._deleted = s.deleted;

        data.actions.forEach(function(a) {

          let prefix = '';

          if (a.action === 'CREATED') {
            prefix = '🆕 TẠO MỚI';
          }

          if (a.action === 'UPDATED') {
            prefix = '🔄 CẬP NHẬT';
          }

          if (a.action === 'UNCHANGED') {
            prefix = '⏭ GIỮ NGUYÊN';
          }

          log(prefix + ': ' + a.title);

        });

        const percent = total
          ? Math.round(data.processed / total * 100)
          : 100;

        $('bar2').style.width =
          percent + '%';

        $('status2').textContent =
          'Đã xử lý ' + data.processed +
          '/' + total + ' sự kiện (' +
          percent + '%)';

        $('bar1').style.width =
          options.clearOld && data.finished
            ? '100%'
            : '0%';

        $('status1').textContent =
          options.clearOld
            ? (
                data.finished
                  ? '✅ Đã dọn lịch cũ và sự kiện trùng mã.'
                  : 'Đang chờ hoàn thành ngày để kiểm tra lịch cũ...'
              )
            : 'Đã tắt chức năng xóa lịch cũ. Không xóa sự kiện nào.';

        $('message').textContent =
          'Đang xử lý ' + day.label +
          ' (' + day.date + ')' +
          '\\nTiến độ: ' +
          data.processed + '/' + total;

        if (data.finished) {

          totals.deleted +=
            s.deleted - (totals._deletedBefore || 0);

          totals._created = 0;
          totals._updated = 0;
          totals._unchanged = 0;
          totals._deleted = 0;

          log('HOÀN TẤT ' + day.label);

          log(
            'Kết quả ngày: Tạo ' +
            s.created +
            ' | Cập nhật ' +
            s.updated +
            ' | Giữ nguyên ' +
            s.unchanged +
            ' | Xóa ' +
            s.deleted
          );

          processDay(dayPosition + 1, options);

        } else {

          processBatch(
            dayPosition,
            dayIndex,
            token,
            data.nextOffset,
            total,
            options
          );

        }

      })

      .withFailureHandler(showError)

      .SCV2_processBatchV22(
        token,
        offset
      );

  }


  /********************************************************
   * HOÀN TẤT
   ********************************************************/

  function finish() {

    running = false;

    $('bar1').style.width = '100%';
    $('bar2').style.width = '100%';

    $('status1').textContent =
      $('clear').checked
        ? '✅ Hoàn tất dọn lịch cũ.'
        : 'Đã tắt xóa lịch cũ — không xóa sự kiện.';

    $('status2').textContent =
      '✅ Hoàn tất đồng bộ tất cả ngày.';

    $('message').textContent =
      '🎉 SMART CALENDAR SYNC V2.2 HOÀN TẤT!';

    $('result').style.display = 'block';

    $('result').innerHTML =
      '<b>📊 KẾT QUẢ ĐỒNG BỘ</b><br>' +
      '📅 Số ngày: ' + selected.length + '<br>' +
      '📌 Tổng sự kiện trong kế hoạch: ' +
        totals.total + '<br>' +
      '🆕 Tạo mới: ' + totals.created + '<br>' +
      '🔄 Cập nhật: ' + totals.updated + '<br>' +
      '⏭️ Không thay đổi: ' + totals.unchanged + '<br>' +
      '🗑️ Đã xóa: ' + totals.deleted + '<br>';

    log('================================');

    log('HOÀN TẤT TOÀN BỘ.');

    $('close').style.display = 'block';

  }


  /********************************************************
   * ĐÓNG
   ********************************************************/

  $('close').addEventListener('click', function() {

    google.script.host.close();

  });


  /********************************************************
   * KHỞI CHẠY
   ********************************************************/

  loadDays();

})();

</script>

</body>
</html>
`;

}
