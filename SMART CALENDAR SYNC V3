<script>

(function() {

  const $ = id => document.getElementById(id);

  let days = [];

  let running = false;


  /*******************************************************
   * LOG
   *******************************************************/

  function log(message) {

    const el = $('liveLog');

    const time = new Date().toLocaleTimeString();

    el.textContent +=
      '\\n[' + time + '] ' + message;

    el.scrollTop = el.scrollHeight;

  }


  /*******************************************************
   * LỖI
   *******************************************************/

  function showError(error) {

    running = false;

    $('message').textContent =
      '❌ ĐỒNG BỘ BỊ GIÁN ĐOẠN';

    $('error').style.display = 'block';

    $('error').textContent =
      error && error.message
        ? error.message
        : String(error);

    log('LỖI: ' + $('error').textContent);

    $('close').style.display = 'block';

  }


  /*******************************************************
   * TẢI NGÀY
   *******************************************************/

  function loadDays() {

    google.script.run

      .withSuccessHandler(function(data) {

        days = data || [];

        $('days').innerHTML = '';

        days.forEach(function(day) {

          const label = document.createElement('label');

          label.className = 'day';

          const checkbox = document.createElement('input');

          checkbox.type = 'checkbox';

          checkbox.className = 'daycb';

          checkbox.value = day.index;

          checkbox.checked = day.valid;

          checkbox.disabled = !day.valid;

          const name = document.createElement('span');

          name.textContent = day.label;

          const date = document.createElement('span');

          date.className = 'day-date';

          date.textContent = day.date;

          label.appendChild(checkbox);

          label.appendChild(name);

          label.appendChild(date);

          $('days').appendChild(label);

        });

        $('all').checked =
          days.some(d => d.valid) &&
          days.every(d => d.valid);

        $('start').disabled =
          !days.some(d => d.valid);

        $('start').textContent =
          'BẮT ĐẦU ĐỒNG BỘ V3';

        updateAllCheckbox();

      })

      .withFailureHandler(showError)

      .SCV3_getDays();

  }


  /*******************************************************
   * CHỌN TẤT CẢ
   *******************************************************/

  function updateAllCheckbox() {

    const boxes = [
      ...document.querySelectorAll('.daycb')
    ];

    const checked = boxes.filter(
      cb => cb.checked
    ).length;

    $('all').checked =
      boxes.length > 0 &&
      checked === boxes.length;

    $('all').indeterminate =
      checked > 0 &&
      checked < boxes.length;

  }


  $('all').addEventListener('change', function() {

    document.querySelectorAll('.daycb')
      .forEach(cb => {

        if (!cb.disabled) {
          cb.checked = this.checked;
        }

      });

  });


  $('days').addEventListener('change', function(e) {

    if (e.target.classList.contains('daycb')) {
      updateAllCheckbox();
    }

  });


  /*******************************************************
   * BẮT ĐẦU ĐỒNG BỘ
   *******************************************************/

  $('start').addEventListener('click', function() {

    if (running) return;

    const selectedDays = [
      ...document.querySelectorAll('.daycb:checked')
    ].map(cb => Number(cb.value));

    if (!selectedDays.length) {

      alert('Vui lòng chọn ít nhất một ngày.');

      return;

    }


    const options = {

      selectedDays: selectedDays,

      clearOld: $('clear').checked,

      createSync: $('create').checked,

      gapMinutes: Number($('gap').value),

      sleepStart: $('sleepStart').value,

      sleepDuration: Number($('sleepDuration').value)

    };


    if (!options.clearOld && !options.createSync) {

      alert('Vui lòng chọn ít nhất một chức năng.');

      return;

    }


    if (
      !Number.isFinite(options.gapMinutes) ||
      options.gapMinutes < 0 ||
      options.gapMinutes > 1440
    ) {

      alert('Khoảng nghỉ phải từ 0 đến 1440 phút.');

      return;

    }


    if (
      !Number.isFinite(options.sleepDuration) ||
      options.sleepDuration <= 0 ||
      options.sleepDuration > 24
    ) {

      alert('Thời lượng ngủ phải lớn hơn 0 và không quá 24 giờ.');

      return;

    }


    if (
      !options.sleepStart ||
      !/^([01]\\d|2[0-3]):[0-5]\\d$/.test(options.sleepStart)
    ) {

      alert('Giờ bắt đầu ngủ không hợp lệ.');

      return;

    }


    if (
      options.clearOld &&
      !options.createSync &&
      !confirm(
        'Bạn có chắc chắn muốn xóa toàn bộ sự kiện ' +
        'do Smart Calendar quản lý trong các ngày đã chọn?'
      )
    ) {

      return;

    }


    running = true;

    $('setup').style.display = 'none';

    $('progress').style.display = 'block';

    $('message').textContent =
      'Đang đồng bộ ' + selectedDays.length + ' ngày...';

    $('status2').textContent =
      'Đang đọc dữ liệu và chuẩn bị Calendar...';

    log('BẮT ĐẦU SMART CALENDAR SYNC V3');

    log('Số ngày được chọn: ' + selectedDays.length);

    log('Khoảng nghỉ: ' + options.gapMinutes + ' phút');

    log('Giờ ngủ: ' + options.sleepStart);

    log('Thời lượng ngủ: ' + options.sleepDuration + ' giờ');

    log('Dọn lịch cũ: ' +
      (options.clearOld ? 'BẬT' : 'TẮT'));

    log('Tạo/cập nhật: ' +
      (options.createSync ? 'BẬT' : 'TẮT'));

    log('Đang chạy chế độ FAST MODE...');


    google.script.run

      .withSuccessHandler(finish)

      .withFailureHandler(showError)

      .SCV3_sync(options);

  });


  /*******************************************************
   * HIỂN THỊ KẾT QUẢ
   *******************************************************/

  function finish(data) {

    running = false;

    const s = data.stats;

    $('bar2').style.width = '100%';

    $('status2').textContent =
      '✅ Hoàn tất đồng bộ.';

    $('message').textContent =
      '🎉 SMART CALENDAR SYNC V3 HOÀN TẤT!';

    $('result').style.display = 'block';

    $('result').innerHTML =

      '<b>📊 KẾT QUẢ ĐỒNG BỘ</b><br>' +

      '📅 Số ngày: ' + data.days + '<br>' +

      '📌 Tổng sự kiện: ' + s.total + '<br>' +

      '🆕 Tạo mới: ' + s.created + '<br>' +

      '🔄 Cập nhật: ' + s.updated + '<br>' +

      '⏭️ Không thay đổi: ' + s.unchanged + '<br>' +

      '🗑️ Đã xóa: ' + s.deleted + '<br>' +

      '<hr>' +

      '⏱️ Khoảng nghỉ: ' +
      data.settings.gapMinutes + ' phút<br>' +

      '💤 Giờ ngủ: ' +
      data.settings.sleepStart + '<br>' +

      '🌙 Thời lượng ngủ: ' +
      data.settings.sleepDuration + ' giờ';


    log('--------------------------------');

    log('TỔNG KẾT:');

    log('Tạo mới: ' + s.created);

    log('Cập nhật: ' + s.updated);

    log('Không thay đổi: ' + s.unchanged);

    log('Đã xóa: ' + s.deleted);


    if (data.actions && data.actions.length) {

      log('--------------------------------');

      log('CHI TIẾT XỬ LÝ:');

      data.actions.forEach(function(a) {

        let prefix = '';

        if (a.action === 'CREATED') {
          prefix = '🆕 TẠO MỚI';
        }

        if (a.action === 'UPDATED') {
          prefix = '🔄 CẬP NHẬT';
        }

        if (a.action === 'UNCHANGED') {
          prefix = '⏭ GIỮ NGUYÊN';
        }

        if (a.action === 'DELETED') {
          prefix = '🗑 XÓA';
        }

        log(
          prefix + ': ' + a.title
        );

      });

    }

    log('================================');

    log('HOÀN TẤT SMART CALENDAR SYNC V3.');

    $('close').style.display = 'block';

  }


  /*******************************************************
   * ĐÓNG
   *******************************************************/

  $('close').addEventListener('click', function() {

    google.script.host.close();

  });


  /*******************************************************
   * KHỞI CHẠY
   *******************************************************/

  loadDays();

})();

</script>

