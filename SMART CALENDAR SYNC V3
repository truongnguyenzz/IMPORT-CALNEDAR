/***************************************************************
 * SMART CALENDAR SYNC V3 — FAST MODE
 *
 * SHEET: TUẦN
 * READY DATE: M16:M22
 * READY TASK: O,Q,S,U,W,Y,AA,AC,AE,AG,AI,AK
 * MASTER: A:G, bắt đầu từ hàng 3
 *
 * MASTER:
 * A = CATEGORY
 * B = CLASS
 * C = TASK NAME
 * D = CONTENT
 * E = PR
 * F = GI
 * G = DURING (hours)
 *
 * V3:
 * - Đọc MASTER một lần.
 * - Đọc toàn bộ READY một lần.
 * - Lấy Calendar events một lần cho khoảng thời gian chung.
 * - Khoảng nghỉ giữa task tùy chỉnh, mặc định 15 phút.
 * - Giờ ngủ tùy chỉnh, mặc định 02:00.
 * - Thời lượng ngủ mặc định 5.5 giờ.
 * - Task được phép kéo dài qua nửa đêm.
 * - Giữ ID cũ SCV2 để nhận diện sự kiện đã đồng bộ.
 * - Chỉ xóa sự kiện do script quản lý.
 ***************************************************************/


const SCV3 = {

  SHEET: 'TUẦN',

  MASTER_ROW: 3,

  READY_FIRST_ROW: 16,
  READY_LAST_ROW: 22,

  DATE_COL: 13,

  TASK_FIRST_COL: 15,
  TASK_LAST_COL: 37,
  TASK_STEP: 2,

  START_HOUR: 7.5,

  DEFAULT_GAP_MINUTES: 15,

  DEFAULT_SLEEP_START: '02:00',
  DEFAULT_SLEEP_DURATION: 5.5,

  SLEEP_TITLE: '💤 Ngủ đêm',

  MARKER: '[[SCV2_ID:',

  TIMEZONE: Session.getScriptTimeZone()

};


const SCV3_DAYS = [
  'THỨ HAI',
  'THỨ BA',
  'THỨ TƯ',
  'THỨ NĂM',
  'THỨ SÁU',
  'THỨ BẢY',
  'CHỦ NHẬT'
];


/***************************************************************
 * 1. MỞ GIAO DIỆN
 *
 * Giữ tên hàm V2 để không phải đổi nút/menu cũ trong Sheet.
 ***************************************************************/

function showCalendarSyncDialogV2() {
  showCalendarSyncDialogV3();
}


function showCalendarSyncDialogV3() {

  const html = HtmlService
    .createHtmlOutput(SCV3_getHTML_())
    .setWidth(680)
    .setHeight(850);

  SpreadsheetApp.getUi().showModalDialog(
    html,
    'SMART CALENDAR SYNC V3'
  );

}


/***************************************************************
 * 2. LẤY DANH SÁCH NGÀY
 ***************************************************************/

function SCV3_getDays() {

  const sheet = SpreadsheetApp
    .getActiveSpreadsheet()
    .getSheetByName(SCV3.SHEET);

  if (!sheet) {
    throw new Error('Không tìm thấy sheet TUẦN.');
  }

  const range = sheet.getRange(
    SCV3.READY_FIRST_ROW,
    SCV3.DATE_COL,
    7,
    1
  );

  const values = range.getValues();
  const displays = range.getDisplayValues();

  return values.map((r, i) => {

    const date = SCV3_parseDate_(
      r[0],
      displays[i][0]
    );

    return {

      index: i,

      valid: !!date,

      label: SCV3_DAYS[i],

      date: date
        ? Utilities.formatDate(
            date,
            SCV3.TIMEZONE,
            'dd/MM/yyyy'
          )
        : 'Chưa có ngày',

      row: SCV3.READY_FIRST_ROW + i

    };

  });

}


/***************************************************************
 * 3. ĐỒNG BỘ V3 — TOÀN BỘ NGÀY ĐƯỢC CHỌN
 ***************************************************************/

function SCV3_sync(options) {

  const lock = LockService.getScriptLock();

  if (!lock.tryLock(10000)) {
    throw new Error(
      'Đang có một tiến trình đồng bộ khác. Vui lòng thử lại.'
    );
  }

  try {

    options = options || {};

    const selectedDays = (
      options.selectedDays || []
    ).map(Number);

    const clearOld = options.clearOld === true;

    const createSync = options.createSync === true;

    const gapMinutes = Number(
      options.gapMinutes
    );

    const sleepStart = String(
      options.sleepStart || SCV3.DEFAULT_SLEEP_START
    );

    const sleepDuration = Number(
      options.sleepDuration
    );

    /*******************************************************
     * VALIDATE SETTINGS
     *******************************************************/

    if (!selectedDays.length) {
      throw new Error('Bạn chưa chọn ngày đồng bộ.');
    }

    if (!clearOld && !createSync) {
      throw new Error('Bạn chưa chọn chức năng đồng bộ.');
    }

    if (
      !Number.isFinite(gapMinutes) ||
      gapMinutes < 0 ||
      gapMinutes > 1440
    ) {
      throw new Error('Khoảng nghỉ không hợp lệ.');
    }

    if (
      !Number.isFinite(sleepDuration) ||
      sleepDuration <= 0 ||
      sleepDuration > 24
    ) {
      throw new Error('Thời lượng ngủ không hợp lệ.');
    }

    if (!/^([01]\d|2[0-3]):[0-5]\d$/.test(sleepStart)) {
      throw new Error('Giờ bắt đầu ngủ không hợp lệ.');
    }

    const uniqueDays = [...new Set(selectedDays)];

    uniqueDays.forEach(index => {

      if (
        !Number.isInteger(index) ||
        index < 0 ||
        index > 6
      ) {
        throw new Error('Ngày được chọn không hợp lệ.');
      }

    });


    /*******************************************************
     * ĐỌC SHEET MỘT LẦN
     *******************************************************/

    const sheet = SpreadsheetApp
      .getActiveSpreadsheet()
      .getSheetByName(SCV3.SHEET);

    if (!sheet) {
      throw new Error('Không tìm thấy sheet TUẦN.');
    }

    // Đọc MASTER đúng một lần.
    const master = SCV3_buildMasterIndex_(sheet);

    // Đọc toàn bộ READY DATE một lần.
    const dateRange = sheet.getRange(
      SCV3.READY_FIRST_ROW,
      SCV3.DATE_COL,
      7,
      1
    );

    const dateValues = dateRange.getValues();
    const dateDisplays = dateRange.getDisplayValues();

    // Đọc toàn bộ READY TASK một lần.
    const readyValues = sheet.getRange(
      SCV3.READY_FIRST_ROW,
      SCV3.TASK_FIRST_COL,
      7,
      SCV3.TASK_LAST_COL -
        SCV3.TASK_FIRST_COL + 1
    ).getDisplayValues();


    /*******************************************************
     * LẬP KẾ HOẠCH CHO TẤT CẢ NGÀY
     *******************************************************/

    const allPlans = [];

    const selectedDateKeys = new Set();

    const selectedDateObjects = [];

    uniqueDays.sort((a, b) => a - b);

    uniqueDays.forEach(dayIndex => {

      const date = SCV3_parseDate_(
        dateValues[dayIndex][0],
        dateDisplays[dayIndex][0]
      );

      if (!date) {

        throw new Error(
          'Ngày tại M' +
          (SCV3.READY_FIRST_ROW + dayIndex) +
          ' không hợp lệ.'
        );

      }

      const dateKey = SCV3_dateKey_(date);

      selectedDateKeys.add(dateKey);

      selectedDateObjects.push(date);

      const plan = createSync
        ? SCV3_buildDayPlan_(
            master,
            readyValues[dayIndex],
            date,
            gapMinutes,
            sleepStart,
            sleepDuration
          )
        : [];

      allPlans.push({

        dayIndex: dayIndex,

        date: date,

        dateKey: dateKey,

        plan: plan

      });

    });


    /*******************************************************
     * TÍNH KHOẢNG THỜI GIAN CALENDAR CHUNG
     *******************************************************/

    let rangeStart = new Date(
      Math.min.apply(
        null,
        selectedDateObjects.map(d => d.getTime())
      )
    );

    rangeStart.setHours(0, 0, 0, 0);

    let maxTime = rangeStart.getTime();

    allPlans.forEach(day => {

      day.plan.forEach(item => {

        if (item.end > maxTime) {
          maxTime = item.end;
        }

      });

    });

    // Thêm một ngày để bao phủ sự kiện qua nửa đêm.
    const rangeEnd = new Date(
      maxTime + 24 * 60 * 60 * 1000
    );


    /*******************************************************
     * LẤY CALENDAR EVENTS MỘT LẦN
     *******************************************************/

    const calendar = CalendarApp.getDefaultCalendar();

    const existingEvents = calendar.getEvents(
      rangeStart,
      rangeEnd
    );


    /*******************************************************
     * TẠO INDEX SỰ KIỆN THEO ID
     *******************************************************/

    const eventById = new Map();

    existingEvents.forEach(event => {

      const id = SCV3_getManagedId_(event);

      if (!id) return;

      if (!eventById.has(id)) {
        eventById.set(id, event);
      }

    });


    /*******************************************************
     * TẬP HỢP ID CẦN GIỮ
     *******************************************************/

    const desiredIds = new Set();

    allPlans.forEach(day => {

      day.plan.forEach(item => {
        desiredIds.add(item.id);
      });

    });


    /*******************************************************
     * THỐNG KÊ
     *******************************************************/

    const stats = {

      created: 0,

      updated: 0,

      unchanged: 0,

      deleted: 0,

      skipped: 0,

      total: 0

    };

    const actions = [];

    allPlans.forEach(day => {
      stats.total += day.plan.length;
    });


    /*******************************************************
     * TẠO / CẬP NHẬT
     *******************************************************/

    if (createSync) {

      allPlans.forEach(day => {

        day.plan.forEach(item => {

          let event = eventById.get(item.id) || null;

          // Nếu chưa tìm thấy ID V2, tìm sự kiện V1.
          if (!event) {

            event = SCV3_findLegacyEvent_(
              existingEvents,
              item
            );

          }

          let action = '';

          if (!event) {

            event = calendar.createEvent(
              item.title,
              new Date(item.start),
              new Date(item.end),
              {
                description: item.description
              }
            );

            stats.created++;

            action = 'CREATED';

          } else {

            const same = (

              event.getTitle() === item.title &&

              (event.getDescription() || '') ===
                item.description &&

              event.getStartTime().getTime() ===
                item.start &&

              event.getEndTime().getTime() ===
                item.end

            );

            if (same) {

              stats.unchanged++;

              action = 'UNCHANGED';

            } else {

              event.setTitle(item.title);

              event.setTime(
                new Date(item.start),
                new Date(item.end)
              );

              event.setDescription(
                item.description
              );

              stats.updated++;

              action = 'UPDATED';

            }

          }


          // Cập nhật màu nếu có.
          if (item.color) {

            try {
              event.setColor(item.color);
            } catch (e) {
              // Không để lỗi màu làm dừng đồng bộ.
            }

          }


          // Đưa sự kiện vừa tạo/cập nhật vào index.
          eventById.set(item.id, event);


          actions.push({

            day: SCV3_DAYS[day.dayIndex],

            action: action,

            title: item.title

          });

        });

      });

    }


    /*******************************************************
     * DỌN LỊCH CŨ
     *
     * Chỉ xóa event có marker SCV2_ID.
     * Chỉ xử lý event bắt đầu vào ngày đã chọn.
     * Không đụng đến lịch cá nhân.
     *******************************************************/

    if (clearOld) {

      const seenIds = new Set();

      existingEvents.forEach(event => {

        const id = SCV3_getManagedId_(event);

        // Không có marker = không phải lịch do script quản lý.
        if (!id) return;

        const eventStartKey = SCV3_dateKey_(
          event.getStartTime()
        );

        // Không xử lý sự kiện bắt đầu từ ngày không được chọn.
        if (!selectedDateKeys.has(eventStartKey)) {
          return;
        }

        const shouldDelete = (

          !desiredIds.has(id) ||

          seenIds.has(id)

        );

        if (shouldDelete) {

          event.deleteEvent();

          stats.deleted++;

          actions.push({

            day: eventStartKey,

            action: 'DELETED',

            title: event.getTitle()

          });

        } else {

          seenIds.add(id);

        }

      });

    }


    /*******************************************************
     * KẾT QUẢ
     *******************************************************/

    return {

      success: true,

      days: uniqueDays.length,

      stats: stats,

      actions: actions,

      settings: {

        gapMinutes: gapMinutes,

        sleepStart: sleepStart,

        sleepDuration: sleepDuration,

        clearOld: clearOld,

        createSync: createSync

      }

    };

  } finally {

    lock.releaseLock();

  }

}


/***************************************************************
 * 4. MASTER DATABASE
 ***************************************************************/

function SCV3_buildMasterIndex_(sheet) {

  const lastRow = sheet.getLastRow();

  if (lastRow < SCV3.MASTER_ROW) {
    throw new Error('MASTER DATABASE đang trống.');
  }

  const count =
    lastRow - SCV3.MASTER_ROW + 1;

  const values = sheet.getRange(
    SCV3.MASTER_ROW,
    1,
    count,
    7
  ).getValues();

  const formulas = sheet.getRange(
    SCV3.MASTER_ROW,
    1,
    count,
    1
  ).getFormulas();

  const map = {};

  let currentCategory = '';

  for (let i = 0; i < values.length; i++) {

    const r = values[i];

    const aValue = String(
      r[0] || ''
    ).trim();

    const aFormula = String(
      formulas[i][0] || ''
    );

    const categoryMatch = (
      aFormula + ' ' + aValue
    ).match(
      /\[\s*Phân loại\s*[:]\s*([^\]]+)\s*\]/i
    );

    if (categoryMatch) {

      currentCategory = categoryMatch[1].trim();

    } else if (aValue) {

      currentCategory = aValue;

    }

    const className = String(
      r[1] || ''
    ).trim();

    const taskName = String(
      r[2] || ''
    ).trim();

    if (!taskName) continue;

    const key = SCV3_normalize_(taskName);

    if (map[key]) continue;

    map[key] = {

      name: taskName,

      className: className,

      content: String(
        r[3] || ''
      ).trim(),

      // PR luôn lấy từ MASTER cột E.
      pr: SCV3_number_(r[4]),

      gi: SCV3_number_(r[5]),

      duration: SCV3_number_(r[6]),

      category:
        className.toUpperCase() === 'SYSTEM'
          ? 'SYSTEM'
          : currentCategory

    };

  }

  return map;

}


/***************************************************************
 * 5. LẬP KẾ HOẠCH MỘT NGÀY
 ***************************************************************/

function SCV3_buildDayPlan_(
  master,
  ready,
  date,
  gapMinutes,
  sleepStart,
  sleepDuration
) {

  const tasks = [];

  const occurrence = {};

  /*******************************************************
   * ĐỌC READY THEO THỨ TỰ O,Q,S...AK
   *******************************************************/

  for (
    let col = SCV3.TASK_FIRST_COL;
    col <= SCV3.TASK_LAST_COL;
    col += SCV3.TASK_STEP
  ) {

    const taskName = String(
      ready[col - SCV3.TASK_FIRST_COL] || ''
    ).trim();

    if (!taskName) continue;

    const key = SCV3_normalize_(taskName);

    const details = master[key];

    if (!details) {

      throw new Error(
        'KHÔNG TÌM THẤY MASTER TASK: ' +
        taskName +
        '\nREADY: ' +
        SCV3_DAYS[date.getDay() === 0 ? 6 : date.getDay() - 1] +
        '\nVui lòng kiểm tra tên tại MASTER cột C.'
      );

    }

    if (
      !Number.isFinite(details.duration) ||
      details.duration <= 0
    ) {

      throw new Error(
        'DURING không hợp lệ: ' + taskName
      );

    }

    occurrence[key] =
      (occurrence[key] || 0) + 1;

    tasks.push({

      name: taskName,

      details: details,

      occurrence: occurrence[key]

    });

  }


  const plan = [];


  /*******************************************************
   * SỰ KIỆN NGỦ ĐÊM
   *******************************************************/

  const sleepParts = sleepStart
    .split(':')
    .map(Number);

  const sleepDate = new Date(date);

  sleepDate.setHours(
    sleepParts[0],
    sleepParts[1],
    0,
    0
  );

  const sleepEnd = new Date(
    sleepDate.getTime() +
    sleepDuration * 60 * 60 * 1000
  );

  const sleepId = SCV3_makeId_(
    date,
    'SLEEP',
    1
  );

  plan.push({

    id: sleepId,

    type: 'SLEEP',

    name: SCV3.SLEEP_TITLE,

    title: SCV3.SLEEP_TITLE,

    description:
      SCV3.MARKER + sleepId + ']]\n' +
      '🌙 NGỦ ĐÊM\n' +
      '📅 NGÀY: ' +
      Utilities.formatDate(
        date,
        SCV3.TIMEZONE,
        'dd/MM/yyyy'
      ),

    start: sleepDate.getTime(),

    end: sleepEnd.getTime(),

    color: CalendarApp.EventColor.GRAY

  });


  /*******************************************************
   * CÁC TASK READY
   *
   * Timeline chạy liên tục.
   * Không giới hạn 23:59.
   * Task có thể kết thúc vào ngày hôm sau.
   *******************************************************/

  let cursor = new Date(date);

  cursor.setHours(
    Math.floor(SCV3.START_HOUR),
    Math.round(
      (SCV3.START_HOUR % 1) * 60
    ),
    0,
    0
  );

  tasks.forEach((task, index) => {

    const details = task.details;

    // Khoảng nghỉ cố định giữa các task.
    if (index > 0) {

      cursor = new Date(
        cursor.getTime() +
        gapMinutes * 60 * 1000
      );

    }

    const start = new Date(cursor);

    const end = new Date(
      start.getTime() +
      details.duration * 60 * 60 * 1000
    );

    const id = SCV3_makeId_(
      date,
      task.name,
      task.occurrence
    );

    const classUpper =
      details.className.toUpperCase();

    const category =
      String(details.category || '').toUpperCase();

    let icon = '';

    if (
      classUpper === 'SYSTEM' ||
      category.includes('SYSTEM')
    ) {

      icon = '⚙️';

    } else if (category.includes('BẢN SẮC')) {

      icon = '🎭';

    } else if (category.includes('ĐẠO ĐỒ')) {

      icon = '🧘';

    } else if (category.includes('SỰ NGHIỆP')) {

      icon = '💼';

    }

    const title =
      (icon ? icon + ' ' : '') + task.name;

    const description =
      SCV3_formatDescription_(
        id,
        details
      );

    let color = null;

    if (details.gi !== 0) {

      color = CalendarApp.EventColor.MAUVE;

    } else if (classUpper === 'SYSTEM') {

      color = CalendarApp.EventColor.RED;

    } else if (
      classUpper === 'KNOWLEDGES' ||
      classUpper === 'CASUAL SKILLS' ||
      classUpper === 'NỘI TẠI'
    ) {

      color = CalendarApp.EventColor.GREEN;

    } else if (
      classUpper === 'DƯỠNG SINH' ||
      classUpper === 'SIÊU SINH' ||
      classUpper === 'TRƯỜNG SINH'
    ) {

      color = CalendarApp.EventColor.YELLOW;

    }

    plan.push({

      id: id,

      type: 'TASK',

      name: task.name,

      title: title,

      description: description,

      start: start.getTime(),

      end: end.getTime(),

      color: color

    });

    // Task tiếp theo bắt đầu sau khi task này kết thúc.
    cursor = end;

  });

  return plan;

}


/***************************************************************
 * 6. DESCRIPTION GOOGLE CALENDAR
 ***************************************************************/

function SCV3_formatDescription_(id, details) {

  const raw = details.content || '';

  const matches = raw.match(/\[(.*?)\]/g);

  let processedContent = '';

  if (matches && matches.length) {

    processedContent = matches.map(m => {

      const clean = m
        .replace(/^\[/, '')
        .replace(/\]$/, '')
        .trim();

      return '\n-> ' + clean;

    }).join('');

  } else {

    processedContent = '\n-> ' + raw;

  }

  return (

    SCV3.MARKER + id + ']]\n' +

    '🏫 CLASS: ' + details.className + '\n' +

    '📌 CÔNG VIỆC: ' + details.name + '\n' +

    '📝 NỘI DUNG: ' + processedContent + '\n' +

    '📊 PR: ' + details.pr + '\n' +

    '⚙️ GI: ' + details.gi + '\n' +

    '⏱️ DURING: ' + details.duration

  );

}


/***************************************************************
 * 7. NHẬN DIỆN ID
 ***************************************************************/

function SCV3_getManagedId_(event) {

  const description =
    event.getDescription() || '';

  const match = description.match(
    /\[\[SCV2_ID:([^\]]+)\]\]/
  );

  return match ? match[1] : null;

}


/***************************************************************
 * 8. NHẬN DIỆN SỰ KIỆN V1
 ***************************************************************/

function SCV3_findLegacyEvent_(events, desired) {

  const desiredDateKey = SCV3_dateKey_(
    new Date(desired.start)
  );

  const candidates = [];

  events.forEach(event => {

    // Không nhận diện sự kiện đã có ID quản lý.
    if (SCV3_getManagedId_(event)) return;

    if (
      SCV3_dateKey_(event.getStartTime()) !==
      desiredDateKey
    ) {
      return;
    }

    const description =
      event.getDescription() || '';

    if (desired.type === 'SLEEP') {

      if (
        event.getTitle() === SCV3.SLEEP_TITLE
      ) {

        candidates.push(event);

      }

      return;

    }

    const match = description.match(
      /📌 CÔNG VIỆC:\s*(.+)/
    );

    if (!match) return;

    if (
      SCV3_normalize_(match[1]) ===
      SCV3_normalize_(desired.name)
    ) {

      candidates.push(event);

    }

  });


  if (!candidates.length) return null;

  candidates.sort((a, b) => {

    const da = Math.abs(
      a.getStartTime().getTime() -
      desired.start
    );

    const db = Math.abs(
      b.getStartTime().getTime() -
      desired.start
    );

    return da - db;

  });

  return candidates[0];

}


/***************************************************************
 * 9. TẠO ID ỔN ĐỊNH
 *
 * Giữ nguyên thuật toán ID V2 để không tạo trùng.
 ***************************************************************/

function SCV3_makeId_(date, name, occurrence) {

  const text =
    SCV3_dateKey_(date) + '|' +
    SCV3_normalize_(name) + '|' +
    occurrence;

  const bytes = Utilities.computeDigest(
    Utilities.DigestAlgorithm.SHA_256,
    text
  );

  const hash = bytes.map(b => {

    return ('0' + (
      (b + 256) % 256
    ).toString(16)).slice(-2);

  }).join('');

  return hash.substring(0, 24);

}


/***************************************************************
 * 10. HÀM HỖ TRỢ
 ***************************************************************/

function SCV3_normalize_(value) {

  return String(value || '')
    .normalize('NFC')
    .trim()
    .replace(/\s+/g, ' ')
    .toUpperCase();

}


function SCV3_number_(value) {

  if (typeof value === 'number') {
    return value;
  }

  const parsed = parseFloat(
    String(value || '')
      .replace(',', '.')
  );

  return isNaN(parsed) ? 0 : parsed;

}


function SCV3_dateKey_(date) {

  return Utilities.formatDate(
    date,
    SCV3.TIMEZONE,
    'yyyyMMdd'
  );

}


function SCV3_parseDate_(value, display) {

  if (
    value instanceof Date &&
    !isNaN(value.getTime())
  ) {

    const d = new Date(value);

    d.setHours(0, 0, 0, 0);

    return d;

  }

  const match = String(display || '').match(
    /^(\d{1,2})[\/.-](\d{1,2})[\/.-](\d{4})$/
  );

  if (match) {

    const d = new Date(
      Number(match[3]),
      Number(match[2]) - 1,
      Number(match[1])
    );

    d.setHours(0, 0, 0, 0);

    return d;

  }

  return null;

}


